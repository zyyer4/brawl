	BUILD.jungle = function(tk)
		light(C(92, 116, 80), C(255, 232, 168), V3(-0.4, -0.8, -0.4))
		local hw = extent()
		local ground = -6
		local LEAF = { C(30, 116, 52), C(48, 146, 60), C(22, 90, 46), C(78, 168, 66) }
