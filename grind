	-- soft round glow made of stacked circles (2D, size is a fraction of the window height)
	local function softBlob(parent, cx, cy, frac, col, tr, steps)
		steps = steps or 5
		local holder = mk("Frame", {
			AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(cx, cy), Size = UDim2.fromScale(frac, frac),
			SizeConstraint = Enum.SizeConstraint.RelativeYY, BackgroundTransparency = 1, BorderSizePixel = 0,
		}, parent)
		for i = 1, steps do
			local k = i / steps
			local c = mk("Frame", {
				AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(1.02 - k * 0.8, 1.02 - k * 0.8),
				BackgroundColor3 = col, BackgroundTransparency = 1 - (1 - tr) / steps * 1.6, BorderSizePixel = 0,
			}, holder)
			mk("UICorner", { CornerRadius = UDim.new(1, 0) }, c)
		end
		return holder
	end
	
	-- twinkling, slowly drifting star layer (one animation for all stars)
	local function starfield(n, cols, zMin, zMax, hwv, drift)
		local list = {}
		for _ = 1, qn(n) do
			local z = rng:NextNumber(zMin, zMax)
			local s = rng:NextNumber(0.07, 0.2)
			list[#list + 1] = {
				p = ellipsoid(world, V3(s, s, s), pick(cols), CF(rng:NextNumber(-hwv * 2, hwv * 2), rng:NextNumber(-11, 11), z), NEON),
				ph = rng:NextNumber(0, 6), sp = (z - zMin + 2) * (drift or 0.03),
			}
		end
		anim(function(dt, t)
			for _, s in ipairs(list) do
				local p = s.p.Position
				local nx = p.X - dt * s.sp
				if nx < -hwv * 2 then nx = hwv * 2 end
				s.p.Position = V3(nx, p.Y, p.Z)
				s.p.Transparency = 0.15 + 0.5 * (sin(t * 2 + s.ph) + 1) / 2
			end
		end)
	end
	
	-- 4-point glint
	local function sparkle(pos, col, size, life)
		local a = box(world, V3(size, size * 0.12, size * 0.12), col, CF(pos), NEON)
		local b = box(world, V3(size * 0.12, size, size * 0.12), col, CF(pos), NEON)
		local t0 = os.clock()
		anim(function(_, t)
			local f = (t - t0) / life
			if f >= 1 then a:Destroy() b:Destroy() return false end
			local k = math.max(sin(f * pi), 0.001)
			a.Size = V3(size * k, size * 0.12, size * 0.12)
			b.Size = V3(size * 0.12, size * k, size * 0.12)
			local cf = CF(pos) * ANG(0, 0, f * 1.4)
			a.CFrame, b.CFrame = cf, cf
		end)
	end
	
	-- expanding ring.  plane: "xy" (faces the camera) or "xz" (lies on the ground)
	local function shock(pos, col, r1, life, plane, n)
		n = qn(n or 18)
		local segs = {}
		for i = 1, n do segs[i] = box(world, V3(0.1, 0.06, 0.06), col, CF(pos), NEON) end
		local t0 = os.clock()
		anim(function(_, t)
			local a = (t - t0) / life
			if a >= 1 then
				for _, s in ipairs(segs) do s:Destroy() end
				return false
			end
			local r = r1 * (1 - (1 - a) ^ 3)
			local w = 0.16 * (1 - a) + 0.02
			for i, s in ipairs(segs) do
				local ang = i / n * 2 * pi
				s.Size = V3(2 * pi * r / n * 1.15 + 0.02, w, w)
				if plane == "xz" then
					s.CFrame = CF(pos + V3(cos(ang) * r, 0, sin(ang) * r)) * ANG(0, -(ang + pi / 2), 0)
				else
					s.CFrame = CF(pos + V3(cos(ang) * r, sin(ang) * r, 0)) * ANG(0, 0, ang + pi / 2)
				end
				s.Transparency = a * a
			end
		end)
	end
	
