	----------------------------------------------------------------
	-- 3D dragon (built from ellipsoids, animated wings + tail)
	----------------------------------------------------------------
	local function dragon3d(pal)
		local K = 0.55
		local function Z(x, y, z) return V3(x, y, z) * K end
		local function L(x, y, z) return CF(x * K, y * K, z * K) end
		local model = mk("Model", {}, world)
		local rig = {}
		local function S(size, col, lcf, mat)
			local p = ellipsoid(model, size, col, CF(), mat)
			rig[#rig + 1] = { p, lcf }
			return p
		end
		S(Z(2.8, 1.3, 1.3), pal.body, L(0, 0, 0))
		S(Z(2.3, 0.7, 1.0), pal.belly, L(0.2, -0.4, 0))
		S(Z(1.5, 1.1, 1.1), pal.body, L(1.1, 0.05, 0))
		S(Z(1.5, 0.5, 0.55), pal.body, L(1.9, 0.55, 0) * ANG(0, 0, rad(30)))
		S(Z(1.1, 0.75, 0.8), pal.body, L(2.6, 0.95, 0))
		S(Z(0.9, 0.4, 0.5), pal.body, L(3.15, 0.85, 0))
		S(Z(0.7, 0.15, 0.4), pal.belly, L(3.1, 0.62, 0))
		for sgn = -1, 1, 2 do
			S(Z(0.2, 0.2, 0.2), pal.glow, L(2.85, 1.12, 0.3 * sgn), NEON)
			S(Z(0.9, 0.16, 0.16), pal.horn, L(2.3, 1.38, 0.22 * sgn) * ANG(0, 0, rad(35)))
			S(Z(0.5, 0.35, 0.3), pal.body, L(0.7, -0.75, 0.45 * sgn))
			S(Z(0.5, 0.35, 0.3), pal.body, L(-0.7, -0.75, 0.45 * sgn))
		end
		for i = 1, 5 do
			S(Z(0.35, 0.42, 0.14), pal.horn, L(1.4 - i * 0.55, 0.72, 0) * ANG(0, 0, rad(-12)))
		end
		local tail = {}
		for i = 1, 8 do
			local s = math.max(0.14, 0.85 - i * 0.09)
			tail[i] = ellipsoid(model, Z(0.8, s, s), i % 3 == 0 and pal.horn or pal.body, CF())
		end
		local tip = ellipsoid(model, Z(0.45, 0.45, 0.45), pal.glow, CF(), NEON)

		local wings = {}
		local MEM = {
			{ V3(-0.7, 0, 0.7), V3(1.7, 0.05, 1.2) },
			{ V3(-0.55, 0, 1.7), V3(1.35, 0.05, 1.1) },
			{ V3(-0.3, 0, 2.5), V3(0.8, 0.05, 0.9) },
		}
		for sgn = -1, 1, 2 do
			local w = { s = sgn, mem = {} }
			w.bone = ellipsoid(model, Z(0.2, 0.2, 2.9), pal.horn, CF())
			w.finger = ellipsoid(model, Z(1.5, 0.12, 0.12), pal.horn, CF())
			for _, m in ipairs(MEM) do
				w.mem[#w.mem + 1] = { p = ellipsoid(model, m[2] * K, pal.wing, CF(), SMOOTH, 0.06), pos = m[1] }
			end
			wings[#wings + 1] = w
		end

		local function update(root, t, speed)
			for _, e in ipairs(rig) do e[1].CFrame = root * e[2] end
			for i, p in ipairs(tail) do
				p.CFrame = root * L(-1.2 - i * 0.62, sin(t * 5 - i * 0.8) * 0.1 * i, cos(t * 3 - i * 0.6) * 0.09 * i)
			end
			tip.CFrame = root * L(-1.2 - 9 * 0.62, sin(t * 5 - 7.2) * 0.9, cos(t * 3 - 5.4) * 0.8)
			local a = sin(t * speed) * 0.7 + 0.2
			for _, w in ipairs(wings) do
				local s = w.s
				local base = root * L(0.4, 0.55, 0.5 * s) * ANG(-a * s, 0, 0)
				w.bone.CFrame = base * L(-0.2, 0, 1.4 * s)
				w.finger.CFrame = base * L(-1.0, 0, 1.3 * s) * ANG(0, 0.5 * s, 0)
				for _, m in ipairs(w.mem) do
					m.p.CFrame = base * L(m.pos.X, 0, m.pos.Z * s)
				end
			end
		end
		return { model = model, update = update, K = K }
	end

	local function flyDragon(pal, dir, y, z, dur, breath)
		local d = dragon3d(pal)
		local hw = extent() + 5
		local t0 = os.clock()
		anim(function(_, t)
			local a = (t - t0) / dur
			if a >= 1 then
				d.model:Destroy()
				return false
			end
			local x = dir * (-hw + 2 * hw * a)
			local yaw = dir == 1 and -0.5 or pi + 0.5
			local root = CF(x, y + sin(a * pi * 3) * 0.5, z) * ANG(0, yaw, 0) * ANG(sin(t * 2) * 0.08, 0, cos(a * pi * 3) * 0.1)
			d.update(root, t, 9)
			local mp = (root * CF(3.5 * d.K, 0.8 * d.K, 0)).Position
			local fwd = root.RightVector
			for _ = 1, 2 do
				emit({
					pos = mp,
					vel = fwd * rng:NextNumber(5, 8) + V3(rng:NextNumber(-1, 1), rng:NextNumber(-0.5, 1.5), rng:NextNumber(-1, 1)),
					size = rng:NextNumber(0.2, 0.45), col = pick(breath), life = 0.7, grow = 2,
				})
			end
		end)
	end

