------------------------------------------------------------------------
-- Brawl logic
------------------------------------------------------------------------
local function releaseFromMachine(force)
	local char = player.Character
	local hum = getHumanoid()
	local hrp = getRoot()
	if not (char and hum and hrp) then return end
	pcall(function()
		hum.Sit = false
		hum.PlatformStand = false
		hrp.Anchored = false
	end)
	if force then
		pcall(function()
			for _, joint in ipairs(hrp:GetJoints()) do
				local p0, p1 = joint.Part0, joint.Part1
				local outside0 = p0 and not p0:IsDescendantOf(char)
				local outside1 = p1 and not p1:IsDescendantOf(char)
				if outside0 or outside1 then
					joint:Destroy()
				end
			end
		end)
	end
end

local function doJump()
	local hum = getHumanoid()
	if not hum then return end
	pcall(function()
		hum.Sit = false
		hum.Jump = true
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end)
end

local function leaveMachineAndJump(token)
	local function valid()
		return state.brawlActive and state.brawlToken == token
	end

	for i = 1, CONFIG.PreJoinJumps do
		if not valid() then return end
		releaseFromMachine(i > 1 and isHeldByMachine())
		doJump()
		task.wait(CONFIG.PreJoinJumpDelay)
	end

	local tries = 0
	while valid() and isHeldByMachine() and tries < CONFIG.PreJoinMaxForce do
		tries += 1
		releaseFromMachine(true)
		doJump()
		task.wait(0.25)
	end
end

local function findPunch()
	local char = player.Character
	local backpack = player:FindFirstChild("Backpack")
	return (char and char:FindFirstChild("Punch")) or (backpack and backpack:FindFirstChild("Punch"))
end

local function equipPunch()
	local tool = findPunch()
	if not tool then return nil end
	local char = player.Character
	if char and tool.Parent ~= char then
		local hum = getHumanoid()
		if hum then pcall(function() hum:EquipTool(tool) end) end
		if tool.Parent ~= char then
			pcall(function() tool.Parent = char end)
		end
	end
	local attackTime = tool:FindFirstChild("attackTime")
	if attackTime and attackTime:IsA("ValueBase") and attackTime.Value ~= 0 then
		pcall(function() attackTime.Value = 0 end)
	end
	return tool
end

local function nearestTarget()
	local hrp = getRoot()
	if not hrp then return nil end
	local myPos = hrp.Position
	local best, bestDist
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local tr = plr.Character:FindFirstChild("HumanoidRootPart")
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			if tr and hum and hum.Health > 0 then
				local d = (tr.Position - myPos).Magnitude
				if d <= CONFIG.ArenaRadius and (not bestDist or d < bestDist) then
					best, bestDist = plr, d
				end
			end
		end
	end
	return best
end

local function findMain()
	local name = string.lower(state.mainName or "")
	if name == "" then return nil end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			if string.lower(plr.Name) == name or string.lower(plr.DisplayName) == name then
				return plr
			end
		end
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and (string.find(string.lower(plr.Name), name, 1, true) or string.find(string.lower(plr.DisplayName), name, 1, true)) then
			return plr
		end
	end
	return nil
end

local lastAltTool = 0
local function altStep()
	local hum = getHumanoid()
	if hum and os.clock() - lastAltTool > 1 then
		lastAltTool = os.clock()
		pcall(function() hum:UnequipTools() end)
	end
	local main = findMain()
	local mRoot = main and main.Character and main.Character:FindFirstChild("HumanoidRootPart")
	local hrp = getRoot()
	if hrp and mRoot and (hrp.Position - mRoot.Position).Magnitude > 6 then
		pcall(function()
			hrp.CFrame = CFrame.new(mRoot.Position + mRoot.CFrame.LookVector * 4, mRoot.Position)
			hrp.Velocity = Vector3.zero
		end)
	end
end

local function hitTarget(target, tool)
	local hrp = getRoot()
	local tChar = target.Character
	local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
	if not (hrp and tRoot) then return end
	pcall(function()
		hrp.CFrame = CFrame.new(tRoot.Position - tRoot.CFrame.LookVector * CONFIG.FollowBehindStuds, tRoot.Position)
		hrp.Velocity = Vector3.zero
	end)
	pcall(fireMuscle, muscleEvent, "punch", "rightHand")
	pcall(fireMuscle, muscleEvent, "punch", "leftHand")
	if tool and tool.Parent == player.Character then
		pcall(function() tool:Activate() end)
	end
end

local function returnToSpot()
	local origin = state.origin
	if not origin then return end
	local hum = getHumanoid()
	if hum then pcall(function() hum:UnequipTools() end) end
	local deadline = os.clock() + CONFIG.ReturnTimeout
	local stable = 0
	while os.clock() < deadline and gui.Parent do
		local hrp = getRoot()
		if hrp then
			if (hrp.Position - origin.Position).Magnitude > CONFIG.ReturnTolerance then
				pcall(function()
					hrp.CFrame = origin
					hrp.Velocity = Vector3.zero
				end)
				stable = 0
			else
				stable += 1
			end
			if stable >= 5 then break end
		end
		task.wait(0.1)
	end
	local h = getHumanoid()
	if state.prevTool and h then
		local bp = player:FindFirstChild("Backpack")
		local prev = bp and bp:FindFirstChild(state.prevTool)
		if prev then pcall(function() h:EquipTool(prev) end) end
	end
	if state.reSit then
		local attempts = state.seatedAtStart and 5 or 1
		for i = 1, attempts do
			task.wait(i == 1 and 0.3 or 1.2)
			if i > 1 and isHeldByMachine() then break end
			pressE()
		end
	end
end

local function finishBrawl(token, reason)
	if state.brawlToken ~= token or not state.brawlActive then return end
	state.brawlActive = false
	setStatus("brawl over (" .. reason .. ") - returning to your spot", COLORS.muted)
	local ok, err = pcall(returnToSpot)
	if not ok then warn("[GrindBrawl] return to spot failed: " .. tostring(err)) end
	state.brawlsDone += 1
	if state.brawlToken == token then
		state.brawlBusy = false
		setStatus(string.format("farming - waiting for next brawl (%d done)", state.brawlsDone), COLORS.green)
	end
end

state.forceFinish = function()
	finishBrawl(state.brawlToken, "watchdog")
end

local function startBrawl(arena)
	if not state.autoBrawl or state.brawlActive then return end
	local hrp = getRoot()
	if not hrp then return end
	state.brawlToken += 1
	local token = state.brawlToken
	state.brawlActive = true
	state.brawlBusy = true
	state.brawlStartedAt = os.clock()
	state.seatedAtStart = isHeldByMachine()
	state.prevTool = nil
	do
		local char = player.Character
		if char then
			for _, t in ipairs(char:GetChildren()) do
				if t:IsA("Tool") and t.Name ~= "Punch" then
					state.prevTool = t.Name
					break
				end
			end
		end
	end
	local startPos = hrp.Position
	if not state.manualOrigin then
		state.origin = hrp.CFrame
	end

	task.spawn(function()
		setStatus("brawl starting (" .. tostring(arena or "?") .. ") - leaving machine", COLORS.text)
		leaveMachineAndJump(token)
		if state.brawlToken ~= token or not state.brawlActive then return end

		setStatus("joining brawl", COLORS.text)
		local joined = false
		local joinStart = os.clock()
		while state.brawlActive and state.brawlToken == token and os.clock() - joinStart < CONFIG.JoinTimeout do
			if isHeldByMachine() then
				releaseFromMachine(true)
				doJump()
			end
			pcall(fireBrawl, brawlEvent, "joinBrawl")
			task.wait(CONFIG.JoinRetryDelay)
			local r = getRoot()
			if r and (r.Position - startPos).Magnitude >= CONFIG.JoinMovedStuds then
				joined = true
				break
			end
		end
		if state.brawlToken ~= token or not state.brawlActive then return end
		if not joined then
			finishBrawl(token, "couldn't get into the arena")
			return
		end

		setStatus(state.altMode and "in the brawl - alt mode (not attacking)" or "in the brawl - fighting", COLORS.red)
		local fightStart = os.clock()
		releaseFromMachine(false)
		local releaseTries = 0
		local tool
		if not state.altMode then tool = equipPunch() end
		while state.brawlActive and state.brawlToken == token and gui.Parent do
			if os.clock() - fightStart > CONFIG.MaxBrawlSeconds then
				finishBrawl(token, "time cap")
				return
			end
			if isHeldByMachine() then
				releaseTries += 1
				releaseFromMachine(releaseTries > 3)
				doJump()
			end
			if state.altMode then
				altStep()
				task.wait(0.15)
			else
				tool = equipPunch()
				local target = nearestTarget()
				if target then
					hitTarget(target, tool)
				end
				task.wait(CONFIG.PunchInterval)
			end
		end
	end)
end

if brawlEvent then
	track(brawlEvent.OnClientEvent:Connect(function(action, arg)
		if action == "brawlStarting" then
			startBrawl(arg)
		elseif action == "endBrawl" then
			if state.brawlActive then
				finishBrawl(state.brawlToken, "endBrawl")
			end
		end
	end))
end

