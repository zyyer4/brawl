setTheme = function(name, animate)
	local def = THEMES[name]
	if not def then return end
	local dark = name ~= "light"
	currentTheme = name
	for obj, props in pairs(bindings) do
		if obj.Parent then
			local goal = {}
			for prop, key in pairs(props) do goal[prop] = tc(key) end
			if animate then
				tween(obj, 0.45, goal, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
			else
				for prop, col in pairs(goal) do obj[prop] = col end
			end
		end
	end
	local dimGoal = def.dim or (dark and 0.22 or 1)

	for _, d in ipairs(gui:GetDescendants()) do
		if d:IsA("TextLabel") then
			local base = d:GetAttribute("StrokeBase")
			if base == nil and d.TextStrokeTransparency < 1 and d.TextStrokeTransparency > 0.2 then
				base = d.TextStrokeTransparency
				d:SetAttribute("StrokeBase", base)
			end
			if base ~= nil then
				local goal = dark and 0 or base
				if animate then
					tween(d, 0.45, { TextStrokeTransparency = goal }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				else
					d.TextStrokeTransparency = goal
				end
			end
		end
	end
	if animate then
		tween(dim, 0.45, { BackgroundTransparency = dimGoal }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		tween(mixValue, 0.45, { Value = dark and 1 or 0 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		themeBtn.Rotation = 0
		tween(themeBtn, 0.5, { Rotation = 360 }, Enum.EasingStyle.Back)
		task.delay(0.55, function() themeBtn.Rotation = 0 end)
		scaler.Scale = fitScale() * 0.97
		tween(scaler, 0.4, { Scale = fitScale() }, Enum.EasingStyle.Back)
	else
		dim.BackgroundTransparency = dimGoal
		mixValue.Value = dark and 1 or 0
	end
	themeBtn.Text = def.icon or "🌙"
	if darkSwitch and darkSwitch.Get() ~= (name == "dark") then darkSwitch:Set(name == "dark", true) end
	Scenes.apply(name, animate)
	if Scenes.refreshChips then Scenes.refreshChips() end
	if Scenes.setBlurb then Scenes.setBlurb(name) end
	pcall(function()
		if writefile then writefile("grindbrawl_theme.txt", name) end
	end)
end

themeBtn.Activated:Connect(function()
	local i = table.find(Scenes.order, currentTheme) or 1
	setTheme(Scenes.order[i % #Scenes.order + 1], true)
end)

do
	local saved = "light"
	pcall(function()
		if isfile and readfile and isfile("grindbrawl_theme.txt") then saved = readfile("grindbrawl_theme.txt") end
	end)
	if saved ~= "light" and THEMES[saved] then setTheme(saved, false) end
end

