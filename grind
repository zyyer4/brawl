		S(V3(0.5, 0.55, 0.06), C(240, 70, 90), CF(-0.6, 0.35, 0) * ANG(0, 0, rad(-25)), nil, true)
		for sgn = -1, 1, 2 do
			S(V3(0.5, 0.06, 0.5), C(240, 70, 90), CF(-0.6, -0.1, 0.4 * sgn), nil, true)
		end
		local flame = ellipsoid(model, V3(0.8, 0.25, 0.25), C(255, 180, 70), CF(), NEON)
		local y0, t0, dur = rng:NextNumber(-2, 4), os.clock(), 10
		anim(function(_, t)
