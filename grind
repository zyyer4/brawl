local function findEgg()
	local char = player.Character
	local backpack = player:FindFirstChild("Backpack")
	local function look(container)
		if not container then return nil end
		local exact = container:FindFirstChild("Protein Egg")
		if exact and exact:IsA("Tool") then return exact end
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") and string.find(string.lower(item.Name), "egg", 1, true) then
				return item
			end
		end
		return nil
	end
	return look(backpack) or look(char)
end

local function eatEgg()
	local egg = findEgg()
	local hum = getHumanoid()
	local char = player.Character
	if not (egg and hum and char) then return false end

	local prevName
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") and t ~= egg then
			prevName = t.Name
			break
		end
	end
	pcall(function() hum:EquipTool(egg) end)
	local waited = 0
	while egg.Parent ~= char and waited < 1 do
		task.wait(0.05)
		waited += 0.05
	end
	pcall(function() egg:Activate() end)
	task.wait(0.35)

	if egg.Parent == char then
		pcall(function() hum:UnequipTools() end)
	end
	if prevName then
		local bp = player:FindFirstChild("Backpack")
		local prev = bp and bp:FindFirstChild(prevName)
		if prev then pcall(function() hum:EquipTool(prev) end) end
	end
	return true
end

