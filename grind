	-- jagged lightning between two points (thin neon boxes that fade out)
	local function bolt(p0, p1, col, life, segs, jag, th)
		segs, jag, th = segs or 6, jag or 0.45, th or 0.07
		local pts = { p0 }
		for i = 1, segs - 1 do
			pts[#pts + 1] = p0:Lerp(p1, i / segs) + V3(rng:NextNumber(-jag, jag), rng:NextNumber(-jag, jag), 0)
		end
		pts[#pts + 1] = p1
		local parts, t0 = {}, os.clock()
		for i = 1, #pts - 1 do
			local a, b = pts[i], pts[i + 1]
			parts[i] = box(world, V3((b - a).Magnitude, th, th), col, CF((a + b) / 2) * ANG(0, 0, math.atan2(b.Y - a.Y, b.X - a.X)), NEON)
		end
		anim(function(_, t)
			local f = (t - t0) / life
			if f >= 1 then
				for _, p in ipairs(parts) do p:Destroy() end
				return false
			end
			for _, p in ipairs(parts) do p.Transparency = f * f end
		end)
	end

