local function addButton(text, callback, primary)
	local row = makeRow(38, "raised")
	row.BackgroundTransparency = 0
	local baseKey = primary and "pink" or "cream_b"
	paint(row, "BackgroundColor3", baseKey)
	local press = create("UIScale", { Scale = 1 }, row)
	local btn = create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = INK,
		TextSize = 14,
		Font = FONT_TITLE,
		AutoButtonColor = false,
	}, row)
	local hovering = false
	if primary then paint(btn, "TextColor3", "onPink") end
	btn.MouseButton1Down:Connect(function() Skin.press(row, true) end)
	btn.MouseButton1Up:Connect(function() Skin.press(row, false) end)
	btn.MouseEnter:Connect(function()
		hovering = true
		Skin.hover(row, true)
		paint(row, "BackgroundColor3", primary and "pinkHover" or "creamHover", 0.15)
		tween(press, 0.2, { Scale = 1.03 }, Enum.EasingStyle.Back)
	end)
	btn.MouseLeave:Connect(function()
		hovering = false
		Skin.hover(row, false)
		Skin.press(row, false)
		paint(row, "BackgroundColor3", baseKey, 0.15)
		tween(press, 0.2, { Scale = 1 })
	end)
	btn.Activated:Connect(function()
		press.Scale = 0.94
		tween(press, 0.3, { Scale = hovering and 1.03 or 1 }, Enum.EasingStyle.Back)
		callback()
	end)
	return btn
end

