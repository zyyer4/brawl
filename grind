do
	local kp, ck = NumberSequenceKeypoint.new, ColorSequenceKeypoint.new
	local WHITE = Color3.new(1, 1, 1)
	-- plain builder: create() would auto-bind white/ink colours to the theme and recolour our overlays
	local function ni(class, props, parent)
		local o = Instance.new(class)
		for k, v in pairs(props) do o[k] = v end
		o.Parent = parent
		return o
	end
	local function rimColor(S, a, b, withMid)
		if S.rimM and withMid then
			return ColorSequence.new({ ck(0, a), ck(0.5, S.rimM), ck(1, b) })
		end
		return ColorSequence.new(a, b)
	end

	local function refresh(rec)
		local S = SKINS[Skin.current] or SKINS.light
		local inset = rec.kind == "inset"
		if rec.pressed then inset = not inset end

		-- shade: bottom falloff for raised surfaces, inner shadow at the top for inset ones
		local seq
		if inset then
			seq = NumberSequence.new({ kp(0, math.max(S.shadeT - 0.22, 0.25)), kp(0.7, 1), kp(1, 1) })
		elseif S.metal then -- polished-metal horizon: a crisp step at mid-height
			seq = NumberSequence.new({ kp(0, 0.96), kp(0.49, 0.88), kp(0.5, math.max(S.shadeT - 0.1, 0)), kp(1, S.shadeT) })
		else
			seq = NumberSequence.new({ kp(0, 1), kp(1, S.shadeT) })
		end
		rec.shade.BackgroundColor3 = S.shade
		rec.shadeG.Transparency = seq

		-- gloss: soft top-lit highlight
		local g = S.gloss
		if rec.lit then g = math.max(g - 0.18, 0.2) end
		if rec.hover then g = math.max(g - 0.08, 0.1) end
		if rec.pressed then g = math.min(g + 0.2, 1) end
		rec.glossF.Visible = not inset
		rec.glossF.BackgroundColor3 = S.glossC or WHITE
		rec.glossG.Transparency = NumberSequence.new({ kp(0, g), kp(1, 1) })

		-- bevel: light catches the top edge, shadow on the bottom (reversed when inset/pressed)
		local a, b = S.rimA, S.rimB
		if inset then a, b = b, a end
		if rec.lit then
			a = a:Lerp(S.glow, 0.7)
			b = b:Lerp(S.glow, 0.35)
		end
		rec.bevG.Color = rimColor(S, a, b, not inset)
		local t = S.rimT
		if rec.lit then t = math.max(t - 0.2, 0) end
		if inset then
			rec.bevG.Transparency = NumberSequence.new({ kp(0, math.min(t + 0.4, 1)), kp(1, t) })
		else
			rec.bevG.Transparency = NumberSequence.new({ kp(0, t), kp(1, math.min(t + 0.4, 1)) })
		end
	end

	function Skin.decorate(obj, kind, radius)
		if Skin.items[obj] then return Skin.items[obj] end
		radius = radius or UDim.new(0, 12)
		local rec = { kind = kind }
		local function layer(z, pos, size)
			local f = ni("Frame", {
				BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = z,
				Position = pos, Size = size, Active = false,
			}, obj)
			ni("UICorner", { CornerRadius = radius }, f)
			return f
		end
		rec.shade = layer(0, UDim2.new(), UDim2.fromScale(1, 1))
		rec.shadeG = ni("UIGradient", { Rotation = 90 }, rec.shade)
		rec.glossF = layer(0, UDim2.fromOffset(2, 2), UDim2.new(1, -4, 0.5, -2))
		rec.glossG = ni("UIGradient", { Rotation = 90 }, rec.glossF)
		local bev = ni("Frame", {
			BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2, Active = false,
			Position = UDim2.fromOffset(1, 1), Size = UDim2.new(1, -2, 1, -2),
		}, obj)
		ni("UICorner", { CornerRadius = radius }, bev)
		ni("UIStroke", { Color = WHITE, Thickness = 1.25, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, bev)
		rec.bevG = ni("UIGradient", { Rotation = 90 }, bev:FindFirstChildOfClass("UIStroke"))
		Skin.items[obj] = rec
		refresh(rec)
		return rec
	end

	local function setState(obj, field, on)
		local rec = Skin.items[obj]
		if rec and rec[field] ~= on then
			rec[field] = on
			refresh(rec)
		end
	end
	function Skin.lit(obj, on) setState(obj, "lit", on and true or false) end
	function Skin.press(obj, on) setState(obj, "pressed", on and true or false) end
	function Skin.hover(obj, on) setState(obj, "hover", on and true or false) end

	-- thin theme-preview strip (used on the theme chips)
	function Skin.swatch(parent, c1, c2, c3)
		local f = ni("Frame", {
			Position = UDim2.new(0, 14, 1, -9), Size = UDim2.new(1, -28, 0, 3),
			BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3, Active = false,
		}, parent)
		ni("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
		ni("UIGradient", { Color = ColorSequence.new({ ck(0, c1), ck(0.5, c2), ck(1, c3) }) }, f)
		return f
	end

	-- window-level lighting: top-left key light, corner vignette, bevel rim, hairline inner frame, soft penumbra
	function Skin.window(win, shadowFrame)
		local function over(z, inset, radius)
			local f = ni("Frame", {
				BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = z, Active = false,
				Position = UDim2.fromOffset(inset, inset), Size = UDim2.new(1, -inset * 2, 1, -inset * 2),
			}, win)
			ni("UICorner", { CornerRadius = UDim.new(0, radius) }, f)
			return f
		end
		local w = {}
		w.hl = over(2, 0, 22)
		w.hlG = ni("UIGradient", { Rotation = 35 }, w.hl)
		w.vig = over(2, 0, 22)
		w.vig.BackgroundColor3 = Color3.new(0, 0, 0)
		w.vigG = ni("UIGradient", { Rotation = 90 }, w.vig)
		local rim = over(4, 2, 20)
		rim.BackgroundTransparency = 1
		local rs = ni("UIStroke", { Color = WHITE, Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, rim)
		w.rimG = ni("UIGradient", { Rotation = 90 }, rs)
		local hair = over(2, 8, 15)
		hair.BackgroundTransparency = 1
		w.hairStroke = ni("UIStroke", { Color = WHITE, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, hair)
		w.pen = ni("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 10, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, shadowFrame)
		Skin.win = w
		Skin.refreshWindow()
	end

	function Skin.refreshWindow()
		local w, S = Skin.win, SKINS[Skin.current] or SKINS.light
		if not w then return end
		w.hl.BackgroundColor3 = S.hl
		w.hlG.Transparency = NumberSequence.new({ kp(0, S.hlT), kp(0.5, 1), kp(1, 1) })
		w.vigG.Transparency = NumberSequence.new({ kp(0, 1), kp(0.55, 1), kp(1, S.vigT) })
		w.rimG.Color = rimColor(S, S.rimA, S.rimB, true)
		w.rimG.Transparency = NumberSequence.new({ kp(0, S.rimT), kp(1, math.min(S.rimT + 0.45, 1)) })
		w.hairStroke.Color = S.frameC
		w.hairStroke.Transparency = S.frameT
		w.pen.Color = S.penC
		w.pen.Transparency = S.pen
	end

	function Skin.setTheme(name)
		if not SKINS[name] then return end
		Skin.current = name
		for obj, rec in pairs(Skin.items) do
			if obj.Parent then refresh(rec) end
		end
		Skin.refreshWindow()
	end
end

