		-- tropical thunderstorm
		local stormDark = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(8, 20, 24), BackgroundTransparency = 1, BorderSizePixel = 0 }, overlay)
		local function storm()
			local t0, dur = os.clock(), 13
			local nextBolt = t0 + 2.5
			TweenService:Create(stormDark, TweenInfo.new(1.8), { BackgroundTransparency = 0.6 }):Play()
			anim(function(_, t)
				local a = t - t0
				if a > dur then
					TweenService:Create(stormDark, TweenInfo.new(2.4), { BackgroundTransparency = 1 }):Play()
					return false
				end
				local k = math.min(1, a / 1.5, (dur - a) / 1.5)
				for _ = 1, math.floor(3 * k + 0.5) do
					emit({
						pos = V3(rng:NextNumber(-hw * 1.3, hw * 1.3), 10, rng:NextNumber(-9, 4)), vel = V3(-2.5, -24, 0), size = 0.035, stretch = 22,
						col = C(190, 215, 235), life = 0.62, fadeAt = 0.75,
					})
				end
				if rng:NextNumber() < 0.35 * k then
					emit({
						pos = V3(rng:NextNumber(-hw, hw), ground + 0.1, rng:NextNumber(-8, 2)), vel = V3(rng:NextNumber(-1, 1), rng:NextNumber(1, 2.5), 0), acc = V3(0, -9, 0),
						size = 0.06, col = C(210, 230, 240), life = 0.4,
					})
				end
				if t > nextBolt then
					nextBolt = t + rng:NextNumber(2, 4)
					local x = rng:NextNumber(-hw, hw)
					bolt(V3(x, 11, -20), V3(x + rng:NextNumber(-3, 3), ground + 0.5, -20), C(235, 240, 255), 0.25, 9, 0.9, 0.14)
					flashScreen(C(225, 235, 255), 0.5, 0.4)
					shake(0.12)
				end
			end)
		end
		task.delay(18, function() if token == tk then storm() end end)
		every(tk, function() return rng:NextNumber(38, 52) end, storm, true)
	
		-- butterflies
		local BFC = { C(70, 150, 255), C(255, 170, 50), C(255, 240, 110) }
		for _, col in ipairs(BFC) do
			local body = ellipsoid(world, V3(0.18, 0.05, 0.05), C(30, 24, 20), CF(), SMOOTH)
			local wl = ellipsoid(world, V3(0.2, 0.02, 0.26), col, CF(), NEON)
			local wr = ellipsoid(world, V3(0.2, 0.02, 0.26), col, CF(), NEON)
			local ph = rng:NextNumber(0, 6)
			local bx, by, bz = rng:NextNumber(-hw * 0.8, hw * 0.8), rng:NextNumber(-3.8, -1.8), rng:NextNumber(-3, 1)
			anim(function(_, t)
				local x, y, z = bx + sin(t * 0.45 + ph) * 3.2, by + sin(t * 1.1 + ph * 2) * 0.7, bz + cos(t * 0.35 + ph) * 1.2
				local heading = cos(t * 0.45 + ph) >= 0 and 0 or pi
				local root = CF(x, y, z) * ANG(0, heading, 0)
				local f = sin(t * 20 + ph) * 0.9 + 0.2
				body.CFrame = root
				wl.CFrame = root * CF(0, 0, 0.14) * ANG(f, 0, 0) * CF(0, 0, 0.13)
				wr.CFrame = root * CF(0, 0, -0.14) * ANG(-f, 0, 0) * CF(0, 0, -0.13)
			end)
		end
	
		every(tk, 0.5, function() -- dust motes drifting in the light shafts
			emit({
				pos = V3(rng:NextNumber(-hw, hw), rng:NextNumber(-3, 6), rng:NextNumber(-8, 0)), vel = V3(rng:NextNumber(-0.2, 0.2), rng:NextNumber(-0.1, 0.2), 0),
				size = 0.05, col = C(255, 246, 200), life = 5, fadeAt = 0.4,
			})
		end)
	end
	
	-- FNAF: camera-feed overlay (scanlines, grain, labels), eyes in the dark, sparks, drips
	local baseFnaf = BUILD.fnaf
	BUILD.fnaf = function(tk)
		baseFnaf(tk)
		local ENABLE_JUMPSCARE = false
		local hw = extent()
		local Wc, floorY = hw * 0.95, -6
		local fontT = FONT_TITLE or Enum.Font.GothamBlack
	
		for i = 1, 26 do -- scanlines
			mk("Frame", { Position = UDim2.fromScale(0, i / 26), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = C(0, 0, 0), BackgroundTransparency = 0.82, BorderSizePixel = 0 }, overlay)
		end
		local grain = {} -- video noise
		for i = 1, 30 do
			grain[i] = mk("Frame", { Size = UDim2.fromOffset(2, 2), BackgroundColor3 = C(255, 255, 255), BackgroundTransparency = 0.9, BorderSizePixel = 0 }, overlay)
		end
		every(tk, 0.07, function()
			for _, g in ipairs(grain) do
				g.Position = UDim2.fromScale(rng:NextNumber(), rng:NextNumber())
				g.BackgroundTransparency = rng:NextNumber(0.8, 0.96)
			end
		end)
		mk("TextLabel", {
			Position = UDim2.new(0, 10, 0, 8), Size = UDim2.fromOffset(220, 16), BackgroundTransparency = 1, Text = "CAM 02  —  SHOW STAGE",
			Font = fontT, TextSize = 12, TextColor3 = C(244, 226, 206), TextXAlignment = Enum.TextXAlignment.Left,
		}, overlay)
		local power = mk("TextLabel", {
			AnchorPoint = V2(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(120, 16), BackgroundTransparency = 1, Text = "POWER 100%",
			Font = fontT, TextSize = 12, TextColor3 = C(244, 226, 206), TextXAlignment = Enum.TextXAlignment.Right,
		}, overlay)
		local pct = 100
		every(tk, 20, function()
			pct = pct <= 12 and 100 or pct - 3
			power.Text = "POWER " .. pct .. "%"
			power.TextColor3 = pct < 30 and C(255, 80, 70) or C(244, 226, 206)
		end, true)
	
		every(tk, function() return rng:NextNumber(6, 12) end, function() -- eyes in the dark
			local x, y, z = rng:NextNumber(-Wc * 0.7, Wc * 0.7), rng:NextNumber(-1, 3), rng:NextNumber(-20, -12)
			local gap = rng:NextNumber(0.35, 0.5)
			local eyes = {}
			for s = -1, 1, 2 do eyes[#eyes + 1] = ellipsoid(world, V3(0.22, 0.12, 0.1), C(255, 255, 255), CF(x + s * gap, y, z), NEON) end
			local t0 = os.clock()
			anim(function(_, t)
				local k = (t - t0) / 1.6
				if k >= 1 then
					for _, e in ipairs(eyes) do e:Destroy() end
					return false
				end
				local tr = sin(k * pi * 7) > 0.4 and 0 or 1
				for _, e in ipairs(eyes) do e.Transparency = tr end
			end)
		end, true)
	
		every(tk, function() return rng:NextNumber(9, 15) end, function() -- ceiling sparks
			local pos = V3(rng:NextNumber(-Wc * 0.5, Wc * 0.5), 6.1, rng:NextNumber(-18, -4))
			burst(pos, 12, { cols = { C(255, 200, 100), C(255, 255, 200) }, min = 1, max = 4, acc = V3(0, -12, 0), s0 = 0.04, s1 = 0.08, l0 = 0.5, l1 = 0.9, stretch = 3 })
			flashScreen(C(255, 210, 140), 0.9, 0.2)
		end, true)
	
		every(tk, 1.7, function() -- dripping pipe
			local x = -Wc * 0.35
			emit({ pos = V3(x, 6, -5), vel = V3(0, -3, 0), acc = V3(0, -14, 0), size = 0.05, stretch = 3, col = C(170, 190, 220), life = 1.15, fadeAt = 0.8 })
			task.delay(1.1, function()
