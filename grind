local sessionStart = os.clock()
local gainDefs = {
	{ label = "Strength",   names = { "Strength" },   rate = true },
	{ label = "Durability", names = { "Durability" }, rate = true },
	{ label = "Rebirths",   names = { "Rebirths" } },
	{ label = "Kills",      names = { "Kills" } },
}

do
	local function findStatValue(names)
		local ls = player:FindFirstChild("leaderstats")
		for _, name in ipairs(names) do
			local v = ls and ls:FindFirstChild(name)
			if not (v and v:IsA("ValueBase")) then
				v = player:FindFirstChild(name, true)
			end
			if v and v:IsA("ValueBase") and type(v.Value) == "number" then
				return v
			end
		end
		return nil
	end

	local tileStyle = {
		Strength = { "💪", Color3.fromRGB(226, 72, 112) },
		Durability = { "🛡️", Color3.fromRGB(36, 156, 168) },
		Rebirths = { "🔄", Color3.fromRGB(128, 92, 206) },
		Kills = { "💀", INK },
	}

	parentFrame = colStats
	sectionLabel("✨ SESSION GAINS")
	local grid = makeGrid()
	local setSession, setSessionSub = addTile(grid, "Session", INK, "🕒")
	local setBrawls, setBrawlsSub = addTile(grid, "Brawls done", INK, "🥊")
	setSessionSub("since reset")
	setBrawlsSub("this session")
	for _, def in ipairs(gainDefs) do
		local style = tileStyle[def.label] or { nil, INK }
		def.setGain, def.setRate = addTile(grid, def.label, style[2], style[1])
	end

	addButton("↺  Reset Gains", function()
		sessionStart = os.clock()
		state.brawlsDone = 0
		for _, def in ipairs(gainDefs) do def.base = nil end
	end, true)

	local frameCount = 0
	track(RunService.RenderStepped:Connect(function() frameCount += 1 end))

	task.spawn(function()
		local lastT = os.clock()
		while gui.Parent do
			local now = os.clock()
			local elapsed = math.max(now - sessionStart, 1)
			local fps = frameCount / math.max(now - lastT, 0.001)
			frameCount = 0
			lastT = now

			-- Stat lookups are cheap but the UI writes aren't needed while hidden
			local visible = gui.Enabled
			for _, def in ipairs(gainDefs) do
				if def.obj and not def.obj.Parent then def.obj = nil end
				if not def.obj and now >= (def.nextSearch or 0) then
					def.obj = findStatValue(def.names)
					def.nextSearch = now + 3
				end
				if def.obj then
					local cur = def.obj.Value
					if def.base == nil then def.base = cur end
					if visible then
						local gained = cur - def.base
						def.setGain((gained >= 0 and "+" or "") .. fmt(gained))
						if def.rate then
							def.setRate(fmt(gained / elapsed * 3600) .. " /hr")
						end
					end
				elseif visible then
					def.setGain("n/a")
				end
			end
			if visible then
				setSession(fmtTime(elapsed))
				setBrawls(tostring(state.brawlsDone))
				local text = string.format("Ping %d ms   •   FPS %d   •   RightShift hides", math.floor(getPing() + 0.5), math.floor(fps + 0.5))
				if footerLabel.Text ~= text then footerLabel.Text = text end
			end
			task.wait(0.5)
		end
	end)
end

------------------------------------------------------------------------
-- CONFIG TAB
------------------------------------------------------------------------
local cfgApi = {}
do
	local CFG_FILE = "GrindBrawl_config.json"
	local CFG_VERSION = 1
	local fileOK = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"

	local cfgStatus
	local function setCfgStatus(text)
		if cfgStatus and cfgStatus.Text ~= text then cfgStatus.Text = text end
	end

	-- Storage: real file when the executor has one, otherwise a table that survives re-execution
	local function readRaw()
		if fileOK then
			local ok, res = pcall(function()
				if isfile(CFG_FILE) then return readfile(CFG_FILE) end
				return nil
			end)
			if ok and type(res) == "string" and res ~= "" then return res end
			return nil
		end
		return env.GrindBrawl_mem
	end

	local function writeRaw(s)
		if fileOK and pcall(writefile, CFG_FILE, s) then
			return "file"
		end
		env.GrindBrawl_mem = s
		return "memory"
	end

	local function deleteRaw()
		env.GrindBrawl_mem = nil
		if fileOK and type(delfile) == "function" then
			pcall(function()
				if isfile(CFG_FILE) then delfile(CFG_FILE) end
			end)
		end
	end

	local function decode(raw)
		if not raw then return nil end
		local ok, cfg = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok and type(cfg) == "table" and type(cfg.values) == "table" then return cfg end
		return nil
	end

	local function decodeSpot(t)
		if type(t) ~= "table" or #t ~= 12 then return nil end
		for i = 1, 12 do
			if type(t[i]) ~= "number" then return nil end
		end
		return CFrame.new(table.unpack(t))
	end

	-- The spot we remember: the locked return spot, else where you're seated right now,
	-- else the last place you were seen seated
	local function currentSpot()
		if state.manualOrigin and state.origin then return state.origin end
		local hrp = getRoot()
		if hrp and isHeldByMachine() then return hrp.CFrame end
		return state.lastSeatCF
	end

	local function collect()
		local values = {}
		for _, c in ipairs(controls) do
			values[c.key] = c.ctl.Get()
		end
		local cfg = { version = CFG_VERSION, values = values }
		local spot = currentSpot()
		if spot then cfg.spot = { spot:GetComponents() } end
		return cfg
	end

	-- Boxes first so rep speed / ping limits are set before their switches start anything
	local function applyValues(values)
		for _, kind in ipairs({ "box", "switch" }) do
			for _, c in ipairs(controls) do
				local v = values[c.key]
				if c.kind == kind and v ~= nil then
					if kind == "box" then
						if type(v) == "string" and v ~= "" then pcall(c.ctl.Set, c.ctl, v) end
					elseif type(v) == "boolean" then
						pcall(c.ctl.Set, c.ctl, v)
					end
				end
			end
		end
	end

	local function stamp() return os.date("%H:%M:%S") end

	local function trySit(spot, goToSpot)
		local t0 = os.clock()
		while gui.Parent and not (getRoot() and getHumanoid()) and os.clock() - t0 < 15 do
			task.wait(0.25)
		end
		for attempt = 1, 6 do
			if not gui.Parent then return false end
			if isHeldByMachine() then return true end
			local hrp = getRoot()
			if goToSpot and spot and hrp and (hrp.Position - spot.Position).Magnitude > CONFIG.ReturnTolerance then
				pcall(function()
					hrp.CFrame = spot
					hrp.Velocity = Vector3.zero
				end)
				task.wait(0.5)
			end
			pressE()
			task.wait(1.2)
		end
		return isHeldByMachine()
	end

	local function runAutoload(cfg)
		local v = cfg.values
		local delay = math.clamp(tonumber(v.loadDelay) or 3, 0, 60)
		setCfgStatus(string.format("Autoload in %ds...", delay))
		task.wait(delay)
		if not gui.Parent then return end

		applyValues(v)
		setCfgStatus("Config loaded " .. stamp())

		local spot = decodeSpot(cfg.spot)
		local wantGo, wantSit = v.goToSpot ~= false, v.autoSit == true
		if spot then
			state.origin = spot
			state.manualOrigin = true
		end
		if not (wantGo or wantSit) then return end
		if not spot and wantGo then
			setCfgStatus("No saved spot - settings loaded " .. stamp())
			if not wantSit then return end
		end

		if wantGo and spot then
			local t0 = os.clock()
			while gui.Parent and not getRoot() and os.clock() - t0 < 15 do task.wait(0.25) end
			local hrp = getRoot()
			if hrp then
				pcall(function()
					hrp.CFrame = spot
					hrp.Velocity = Vector3.zero
				end)
			end
		end
		if wantSit then
			if trySit(spot, wantGo) then
				setCfgStatus("Config loaded - seated " .. stamp())
			else
				setCfgStatus("Couldn't sit - stand on your weight " .. stamp())
			end
		end
	end

	parentFrame = colCfg
	sectionLabel("💾 SAVE / LOAD")
	cfgStatus = addTextRow("No saved config yet", 46)

	addButton("💾  Save Config", function()
		local cfg = collect()
		local ok, json = pcall(HttpService.JSONEncode, HttpService, cfg)
		if not ok then
			setCfgStatus("Save failed: couldn't encode")
			return
		end
		local where = writeRaw(json)
		local msg = "Saved " .. stamp() .. (where == "file" and " (file)" or " (memory only - no file access)")
		if not cfg.spot then msg = msg .. " - no spot saved" end
		setCfgStatus(msg)
	end, true)

	addButton("📂  Load Config", function()
		local cfg = decode(readRaw())
		if not cfg then
			setCfgStatus("Nothing to load")
			return
		end
		applyValues(cfg.values)
		local spot = decodeSpot(cfg.spot)
		if spot then
			state.origin = spot
			state.manualOrigin = true
		end
		setCfgStatus("Config loaded " .. stamp())
	end)

	addButton("🗑️  Delete Saved Config", function()
		deleteRaw()
		setCfgStatus("Saved config deleted")
	end)

	sectionLabel("🚀 AUTOLOAD")
	addSwitch("Autoload on execute", false, function() end, "autoload")
	addSwitch("Go to saved spot", true, function() end, "goToSpot")
	addSwitch("Press E to sit", false, function() end, "autoSit")
	addBox("Load Delay (s)", "3", function() end, "loadDelay")
	addLabel("Save Config stores every switch and box in the script, plus your return spot (or where you're sitting). With Autoload on, the next execute restores it all, walks to the spot and sits.", 62)

	if not fileOK then
		addLabel("This executor has no file functions - config is kept in memory until you leave the game.", 34)
	end

	cfgApi.start = function()
		local raw = readRaw()
		if not raw then
			setCfgStatus("No saved config yet")
			return
		end
		local cfg = decode(raw)
		if not cfg then
			setCfgStatus("Saved config is unreadable")
			return
		end
		if cfg.values.autoload == true then
			local ok, err = pcall(runAutoload, cfg)
			if not ok then
				warn("[GrindBrawl] autoload failed: " .. tostring(err))
				setCfgStatus("Autoload error - see console")
			end
		else
			setCfgStatus("Saved config found - autoload is off")
		end
	end
end

