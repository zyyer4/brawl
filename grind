	local function rocket()
		local hw = extent() + 4
		local model = mk("Model", {}, world)
		local rig = {}
		local function S(size, col, lcf, mat, isBox)
			local p = (isBox and box or ellipsoid)(model, size, col, CF(), mat)
			rig[#rig + 1] = { p, lcf }
			return p
		end
		S(V3(1.5, 0.55, 0.55), C(235, 238, 248), CF(0, 0, 0))
		S(V3(0.6, 0.5, 0.5), C(240, 70, 90), CF(0.85, 0, 0))
