		if not container then return nil end
		local exact = container:FindFirstChild("Protein Egg")
		if exact and exact:IsA("Tool") then return exact end
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool") and string.find(string.lower(item.Name), "egg", 1, true) then
				return item
			end
		end
		return nil
	end
	return look(backpack) or look(char)
end

local function eatEgg()
	local egg = findEgg()
	local hum = getHumanoid()
	local char = player.Character
	if not (egg and hum and char) then return false end

	local prevName
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") and t ~= egg then
			prevName = t.Name
			break
		end
	end
	pcall(function() hum:EquipTool(egg) end)
	local waited = 0
	while egg.Parent ~= char and waited < 1 do
		task.wait(0.05)
		waited += 0.05
	end
	pcall(function() egg:Activate() end)
	task.wait(0.35)

	if egg.Parent == char then
		pcall(function() hum:UnequipTools() end)
	end
	if prevName then
		local bp = player:FindFirstChild("Backpack")
		local prev = bp and bp:FindFirstChild(prevName)
		if prev then pcall(function() hum:EquipTool(prev) end) end
	end
	return true
end

local eggLoopRunning = false
local function setEggText(s)
	if eggStatusLabel and eggStatusLabel.Text ~= s then eggStatusLabel.Text = s end
end
local function eggLoop()
	if eggLoopRunning then return end
	eggLoopRunning = true
	local nextEat = 0
	while state.autoEgg and gui.Parent do
		if state.brawlBusy then
			setEggText("Egg: waiting for brawl to finish")
			task.wait(0.5)
		elseif os.clock() >= nextEat then
			if eatEgg() then
				state.eggsEaten += 1
				nextEat = os.clock() + state.eggInterval
			else
				nextEat = os.clock() + 10
				setEggText("Egg: none in backpack - retrying")
			end
			task.wait(0.2)
		else
			setEggText(string.format("Egg: eaten %d | next in %s", state.eggsEaten, fmtTime(nextEat - os.clock())))
			task.wait(0.5)
		end
	end
	eggLoopRunning = false
	setEggText("Egg: off")
end

