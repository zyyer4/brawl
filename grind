local function addSwitch(text, default, callback, key)
	local row = makeRow(42)
	create("TextLabel", {
		Position = UDim2.new(0, 14, 0, 0),
		Size = UDim2.new(1, -86, 1, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = INK,
		TextSize = 14,
		Font = FONT_TITLE,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local track_ = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(52, 28),
		BackgroundColor3 = COLORS.off,
		Text = "",
		AutoButtonColor = false,
	}, row)
	create("UICorner", { CornerRadius = UDim.new(1, 0) }, track_)
	create("UIStroke", { Color = INK, Thickness = 2 }, track_)
	Skin.decorate(track_, "inset", UDim.new(1, 0))
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = CREAM,
		BorderSizePixel = 0,
	}, track_)
	paint(knob, "BackgroundColor3", "knob")
	create("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)
	create("UIStroke", { Color = INK, Thickness = 2 }, knob)
	Skin.decorate(knob, "raised", UDim.new(1, 0))
	local eyes = {}
	for i = 1, 2 do
		local eye = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(i == 1 and 0.32 or 0.68, 0, 0.45, 0),
			Size = UDim2.fromOffset(4, 1),
			BackgroundColor3 = INK,
			BorderSizePixel = 0,
		}, knob)
		create("UICorner", { CornerRadius = UDim.new(1, 0) }, eye)
		eyes[i] = eye
	end
	local value = false
	local function set(v, fire)
		value = v and true or false
		if fire then
			tween(knob, 0.1, { Size = UDim2.fromOffset(27, 20) })
			task.delay(0.1, function()
				tween(knob, 0.25, { Size = UDim2.fromOffset(22, 22) }, Enum.EasingStyle.Back)
			end)
		end
		tween(knob, 0.25, { Position = value and UDim2.new(1, -25, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }, Enum.EasingStyle.Back)
		paint(track_, "BackgroundColor3", value and "pink" or "off", 0.2)
		Skin.lit(track_, value)
		for _, e in ipairs(eyes) do
			tween(e, 0.2, { Size = value and UDim2.fromOffset(4, 5) or UDim2.fromOffset(4, 1) })
		end
		if fire and callback then callback(value) end
	end
	track_.Activated:Connect(function() set(not value, true) end)
	set(default, false)
	local ctl = { Set = function(_, v, silent) set(v, not silent) end, Get = function() return value end }
	if key then controls[#controls + 1] = { key = key, kind = "switch", ctl = ctl } end
	return ctl
end

