					shock(e0 + V3(0, 1, 0), C(255, 230, 160), 6, 0.9, "xy", 24)
					burst(e0, 16, { cols = { C(90, 80, 70), C(140, 120, 100) }, mat = SMOOTH, min = 1, max = 4, s0 = 0.5, s1 = 1, grow = 2, l0 = 2, l1 = 3, fadeAt = 0.3 })
					return false
				end
				local p = s0:Lerp(e0, a ^ 1.2)
				head.Position, core.Position = p, p
				for _ = 1, 2 do
					emit({
						pos = p, vel = V3(rng:NextNumber(-0.5, 0.5), rng:NextNumber(-0.2, 0.8), 0), size = rng:NextNumber(0.25, 0.5),
