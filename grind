local tabs = {}
local currentTab

local function selectTab(name, instant)
	local idx = tabs[name].index
	local prev = currentTab and tabs[currentTab]
	local dir = (prev and idx < prev.index) and -1 or 1
	currentTab = name
	for tabName, t in pairs(tabs) do
		local on = tabName == name
		paint(t.button, "TextColor3", on and "cream_t" or "ink_t", 0.2)
		if on then
			t.page.Visible = true
			if instant then
				t.page.Position = UDim2.new()
				t.page.GroupTransparency = 0
			else
				t.page.Position = UDim2.new(0, 28 * dir, 0, 6)
				t.page.GroupTransparency = 1
				tween(t.page, 0.38, { Position = UDim2.new() }, Enum.EasingStyle.Back)
				tween(t.page, 0.28, { GroupTransparency = 0 })
			end
		elseif t.page.Visible then
			if instant then
				t.page.Visible = false
			else
				local pg = t.page
				tween(pg, 0.14, { GroupTransparency = 1, Position = UDim2.new(0, -18 * dir, 0, 0) })
				task.delay(0.15, function()
					if currentTab ~= tabName then pg.Visible = false end
				end)
			end
		end
	end
	tween(indicator, 0.32, { Position = UDim2.new((idx - 1) / TAB_COUNT, 3, 0, 3) }, Enum.EasingStyle.Back)
end

local tabCount = 0
local function newTab(name, label)
	tabCount += 1

	local wrapper = create("CanvasGroup", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
	}, pageHolder)
	local page = create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = INK,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, wrapper)
	create("UIPadding", {
		PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 2), PaddingTop = UDim.new(0, 2),
	}, page)
	create("UIListLayout", { Padding = UDim.new(0, 9), SortOrder = Enum.SortOrder.LayoutOrder }, page)

	local button = create("TextButton", {
		Position = UDim2.new((tabCount - 1) / TAB_COUNT, 0, 0, 0),
		Size = UDim2.new(1 / TAB_COUNT, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = label,
		TextColor3 = INK,
		TextSize = 11,
		Font = FONT_TITLE,
		AutoButtonColor = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 2,
	}, tabBar)
	button.Activated:Connect(function() selectTab(name) end)

	tabs[name] = { page = wrapper, button = button, index = tabCount }
	return page
end

