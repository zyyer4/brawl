			rig[#rig + 1] = { brim, CF(0, 2.9 * K, 0) * ANG(0, 0, rad(90)) }
		end
		return { model = model, update = function(root) for _, e in ipairs(rig) do e[1].CFrame = root * e[2] end end }
	end

