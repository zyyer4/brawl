					burst(V3(x, floorY + 0.1, -5), 3, { cols = { C(170, 190, 220) }, min = 0.6, max = 1.6, acc = V3(0, -6, 0), s0 = 0.03, s1 = 0.06, l0 = 0.3, l1 = 0.5 })
				end
			end)
		end)
	
		if ENABLE_JUMPSCARE then
			every(tk, function() return rng:NextNumber(50, 80) end, function()
				flashScreen(C(255, 30, 20), 0.35, 0.35)
				shake(0.35)
				local eyes = {}
				for s = -1, 1, 2 do
					local e = mk("Frame", {
						AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5 + s * 0.14, 0.45), Size = UDim2.fromOffset(46, 30),
						BackgroundColor3 = C(255, 255, 255), BorderSizePixel = 0, ZIndex = 5,
					}, overlay)
					mk("UICorner", { CornerRadius = UDim.new(1, 0) }, e)
					eyes[#eyes + 1] = e
				end
				task.delay(0.22, function() for _, e in ipairs(eyes) do if e.Parent then e:Destroy() end end end)
			end, true)
		end
	end
	
	-- keep scene state clean: every scene starts with the default camera and no shake
	for name, fn in pairs(BUILD) do
		BUILD[name] = function(tk)
			camFn, shakeAmt = nil, 0
			return fn(tk)
		end
	end

	----------------------------------------------------------------
	-- apply a theme's scene + card transparency + neon colours
	----------------------------------------------------------------
	local cards
	function Scenes.apply(name, animate)
		local def = THEMES[name]
		if not def then return end
		lastName = name
		token += 1
		table.clear(anims)
		table.clear(P3)
		layer:ClearAllChildren()
		overlay:ClearAllChildren()
		world:ClearAllChildren()
		local build = def.scene and BUILD[def.scene]
		scene.Visible = true
		grad.Color = ColorSequence.new(def.bgTop or def.bg, def.bgBot or def.bg)
		veilGradient.Transparency = SCENE_VEIL
		if build then
			local ok, err = pcall(build, token)
			if not ok then warn("[GrindBrawl] scene build: " .. tostring(err)) end
		else
			-- Sakura and Midnight get their own looping cinematic particle treatment too.
			local paletteA = def.neonA or (name == "light" and C(255, 150, 190) or C(150, 130, 255))
			local paletteB = def.neonB or (name == "light" and C(255, 225, 235) or C(80, 200, 255))
			for i = 1, 18 do
				local orb = mk("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(rng:NextNumber(0.04, 0.96), rng:NextNumber(0.05, 0.95)),
					Size = UDim2.fromOffset(rng:NextInteger(5, 18), rng:NextInteger(5, 18)),
					BackgroundColor3 = i % 2 == 0 and paletteA or paletteB,
					BackgroundTransparency = rng:NextNumber(0.18, 0.48),
					BorderSizePixel = 0, ZIndex = 1,
				}, layer)
				mk("UICorner", { CornerRadius = UDim.new(1, 0) }, orb)
				loopTween(orb, rng:NextNumber(3, 7), {
					Position = UDim2.fromScale(rng:NextNumber(0.04, 0.96), rng:NextNumber(0.05, 0.95)),
					Rotation = rng:NextInteger(-180, 180),
				})
			end
		end
		Scenes.neonA, Scenes.neonB = def.neonA or PINK, def.neonB or TEAL

		if not cards then
			cards = {}
			for _, d in ipairs(window:GetDescendants()) do
				if d:IsA("Frame") and not d:IsDescendantOf(scene) and math.abs(d.BackgroundTransparency - 0.06) < 0.001 then
					cards[#cards + 1] = d
				end
			end
		end
		local goal = def.card or 0.06
		for _, d in ipairs(cards) do
			if d.Parent then
				if animate then tween(d, 0.4, { BackgroundTransparency = goal }) else d.BackgroundTransparency = goal end
			end
		end
	end

	-- the 3D layout depends on the window's aspect ratio: rebuild (debounced) when it changes
	do
		local pending = 0
		vp:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			pending += 1
			local my = pending
			task.delay(0.4, function()
				if my == pending and lastName and gui.Parent and vp.AbsoluteSize.Y > 200 then
					Scenes.apply(lastName, false)
				end
			end)
		end)
	end
end

