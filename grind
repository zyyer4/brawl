	-- 3D goblin (hunter) / floating sword (murim) / rocket (space)
	----------------------------------------------------------------
	local function goblin3d()
		local model = mk("Model", {}, world)
		local rig, legs, arms = {}, {}, {}
		local green, dark = C(110, 190, 70), C(60, 120, 44)
		local function S(size, col, lcf, mat)
			local p = ellipsoid(model, size, col, CF(), mat)
			rig[#rig + 1] = { p, lcf }
			return p
		end
		S(V3(0.7, 0.9, 0.7), green, CF(0, 0, 0))
		S(V3(0.7, 0.45, 0.72), C(120, 70, 44), CF(0, -0.35, 0))
		S(V3(0.7, 0.62, 0.62), green, CF(0.12, 0.78, 0))
		S(V3(0.16, 0.16, 0.16), dark, CF(0.5, 0.72, 0))
		for sgn = -1, 1, 2 do
			S(V3(0.15, 0.17, 0.6), green, CF(0, 0.85, 0.5 * sgn) * ANG(rad(25 * sgn), 0, 0))
			S(V3(0.13, 0.13, 0.13), C(255, 70, 70), CF(0.42, 0.85, 0.2 * sgn), NEON)
			legs[#legs + 1] = { p = ellipsoid(model, V3(0.24, 0.5, 0.24), dark, CF()), s = sgn }
			arms[#arms + 1] = { p = ellipsoid(model, V3(0.2, 0.55, 0.2), green, CF()), s = sgn }
		end
		local club = box(model, V3(0.14, 0.95, 0.14), C(120, 80, 46), CF())
		local clubHead = ellipsoid(model, V3(0.36, 0.36, 0.36), C(100, 66, 38), CF())
		local function update(root, t)
			for _, e in ipairs(rig) do e[1].CFrame = root * e[2] end
			for _, l in ipairs(legs) do
				l.p.CFrame = root * CF(0, -0.45, 0.2 * l.s) * ANG(0, 0, sin(t * 7 + l.s * 1.57) * 0.7) * CF(0, -0.28, 0)
			end
			for _, a in ipairs(arms) do
				a.p.CFrame = root * CF(0.05, 0.25, 0.48 * a.s) * ANG(0, 0, sin(t * 7 - a.s * 1.57) * 0.6) * CF(0, -0.25, 0)
			end
			local hand = root * CF(0.1, -0.05, 0.5) * ANG(0, 0, rad(-35 + sin(t * 7) * 15))
			club.CFrame = hand * CF(0, 0.35, 0)
			clubHead.CFrame = hand * CF(0, 0.85, 0)
		end
		return { model = model, update = update }
	end

	local function sword3d(parent)
		local model = mk("Model", {}, parent)
		local rig = {}
		local function B(size, col, lcf, mat)
			local p = box(model, size, col, CF(), mat)
