			}, layer)
			mk("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ kp(0, 0.2), kp(1, 1) }) }, shaft)
			loopTween(shaft, 3 + i, { BackgroundTransparency = 0.95 })
		end

		-- sun, misty mountains, ground
		ellipsoid(world, V3(13, 13, 0.4), C(255, 214, 120), CF(hw * 0.5, 5.5, -36), NEON, 0.88)
		ellipsoid(world, V3(7, 7, 0.4), C(255, 238, 170), CF(hw * 0.5, 5.5, -35.5), NEON, 0.15)
		for i = 1, 5 do
			local w, h = rng:NextNumber(14, 22), rng:NextNumber(8, 14)
			ellipsoid(world, V3(w, h, 6), C(70, 112, 92):Lerp(HAZE, 0.35), CF(-hw * 2.2 + (i - 0.5) * (hw * 4.4 / 5), -6 + h * 0.2, -30), SMOOTH)
		end
		box(world, V3(90, 0.6, 40), C(20, 62, 28), CF(0, ground - 0.3, -8), GRASS)

		-- palms
		local function palm(x, z, h, d, lean)
			local n = 5
			for i = 1, n do
				local f = (i - 0.5) / n
				ellipsoid(world, V3(0.5 - f * 0.18, h / n * 1.3, 0.5 - f * 0.18), shade(C(104, 70, 42), d), CF(x + lean * f * f * h, ground + f * h, z) * ANG(0, 0, -lean * f * 2), WOOD)
			end
			local top = V3(x + lean * h, ground + h, z)
			for k = 1, 3 do
				ellipsoid(world, V3(0.4, 0.4, 0.4), shade(C(86, 56, 30), d), CF(top + V3(cos(k * 2.1) * 0.35, -0.35, sin(k * 2.1) * 0.35)), SMOOTH)
			end
			local leaves = {}
			for k = 1, 9 do
				leaves[k] = { p = ellipsoid(world, V3(3.4, 0.07, 0.8), shade(pick(LEAF), d), CF(), SMOOTH), a = k / 9 * 2 * pi }
			end
			local ph = rng:NextNumber(0, 6)
			anim(function(_, t)
				for _, l in ipairs(leaves) do
					local droop = 0.5 + sin(t * 1.1 + ph + l.a * 2) * 0.09
					l.p.CFrame = CF(top) * ANG(0, l.a, 0) * ANG(0, 0, -droop) * CF(1.7, 0, 0)
				end
			end)
		end
		palm(-hw * 0.9, -12, 11, -0.1, -0.1)
		palm(hw * 0.75, -11, 10, 0.05, 0.1)
		palm(hw * 0.2, -7, 12, 0.3, -0.08)
		palm(-hw * 0.35, -5, 11, 0.35, 0.1)
		palm(-hw * 1.05, 0.5, 14, 0.78, 0.14)
		palm(hw * 1.1, 0.5, 15, 0.8, -0.12)

		-- ferns
		local ferns = {}
		for _ = 1, 7 do
			local x, z = rng:NextNumber(-hw * 1.1, hw * 1.1), rng:NextNumber(-6, 3)
			local d = z > 0 and 0.5 or (z > -3 and 0.2 or 0)
			for k = 1, 5 do
				ferns[#ferns + 1] = {
					p = ellipsoid(world, V3(2.0, 0.05, 0.5), shade(pick(LEAF), d), CF(), SMOOTH),
					x = x, z = z, a = k / 5 * 2 * pi + rng:NextNumber(0, 1), lift = rng:NextNumber(0.5, 0.9), ph = rng:NextNumber(0, 6),
				}
			end
		end
		-- hanging vines
		local vines = {}
		for i = 1, 5 do
			local segs = {}
			for k = 1, 6 do segs[k] = ellipsoid(world, V3(0.12, 1.0, 0.12), shade(C(40, 110, 50), 0.3), CF(), SMOOTH) end
			vines[i] = { x = rng:NextNumber(-hw, hw), z = rng:NextNumber(-4, 0), segs = segs, ph = rng:NextNumber(0, 6) }
		end
		anim(function(_, t)
			for _, f in ipairs(ferns) do
				f.p.CFrame = CF(f.x, ground + 0.15, f.z) * ANG(0, f.a, 0) * ANG(0, 0, f.lift + sin(t * 1.3 + f.ph) * 0.07) * CF(1.0, 0, 0)
			end
			for _, v in ipairs(vines) do
				for k, s in ipairs(v.segs) do
					local w = sin(t * 0.8 + v.ph + k * 0.35)
					s.CFrame = CF(v.x + w * 0.12 * k, 9.2 - k * 0.95, v.z) * ANG(0, 0, w * 0.06)
				end
			end
		end)

		-- drifting ground mist
		for i = 1, 4 do
			local m = ellipsoid(world, V3(rng:NextNumber(7, 10), 0.8, 3), C(220, 236, 220), CF(0, ground + 0.6 + i * 0.3, rng:NextNumber(-9, -2)), SMOOTH, 0.85)
			local x0, sp = rng:NextNumber(-hw, hw), rng:NextNumber(0.1, 0.25) * (i % 2 == 0 and 1 or -1)
			anim(function(_, t)
				local p = m.Position
				m.Position = V3(((x0 + t * sp + hw * 1.5) % (hw * 3)) - hw * 1.5, p.Y, p.Z)
			end)
		end

		-- brachiosaurus browsing above the canopy
		do
			local bx, bz = -hw * 0.55, -17
			local col = C(104, 138, 98):Lerp(HAZE, 0.25)
			local function E(size, pos) return ellipsoid(world, size, col, CF(pos), SMOOTH) end
			E(V3(6, 3.2, 2.6), V3(bx, ground + 4.3, bz))
			for _, o in ipairs({ { -1.8, 0.9 }, { -1.8, -0.9 }, { 1.8, 0.9 }, { 1.8, -0.9 } }) do
				E(V3(1.1, 3.4, 1.1), V3(bx + o[1], ground + 1.7, bz + o[2]))
			end
			for i = 1, 6 do
				E(V3(1.8 - i * 0.22, 1.1 - i * 0.14, 1.1 - i * 0.14), V3(bx - 3.2 - i * 1.0, ground + 4.5 - i * 0.3, bz))
			end
			local neck = {}
			for i = 1, 8 do neck[i] = ellipsoid(world, V3(1.6, 1.3 - i * 0.1, 1.3 - i * 0.1), col, CF(), SMOOTH) end
			local head = ellipsoid(world, V3(1.5, 0.7, 0.7), col, CF(), SMOOTH)
			anim(function(_, t)
				local px, py = bx + 2.6, ground + 5.2
				for i, s in ipairs(neck) do
					local a = rad(52 + i * 4.5 - math.max(0, i - 5) * 16) + sin(t * 0.5 - i * 0.4) * 0.05
					s.CFrame = CF(px + cos(a) * 0.7, py + sin(a) * 0.7, bz) * ANG(0, 0, a)
					px += cos(a) * 1.25
					py += sin(a) * 1.25
				end
				head.CFrame = CF(px + 0.6, py + 0.1, bz) * ANG(0, 0, rad(-10) + sin(t * 1.8) * 0.15)
			end)
		end

		-- dinosaurs
		local TREX_PAL = { body = C(84, 108, 62), belly = C(196, 184, 124), stripe = C(40, 58, 36), eye = C(255, 210, 60) }
		local TREX = { K = 0.85, fat = 1, head = 1, arm = 1, tailN = 8, tailStep = 0.7, l1 = 1.5, l2 = 1.5, swing = 0.4, speed = 4.5, roar = 0.6 }
		local RAP_PAL = { body = C(190, 92, 40), belly = C(240, 214, 160), stripe = C(36, 36, 40), eye = C(255, 240, 80) }
		local RAPTOR = { K = 0.55, fat = 0.5, head = 0.6, arm = 1.6, tailN = 9, tailStep = 0.62, l1 = 1.3, l2 = 1.6, swing = 0.7, speed = 14 }

		local function crossDino(pal, p, dir, z, dur, dust, a0)
			local d = theropod(pal, p)
			local hw2 = extent() + 8
