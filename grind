	local function drawPixels(container, palette, rows)
		local GH, GW = #rows, #rows[1]
		local colors = {}
		for i, hex in ipairs(palette) do
			colors[i - 1] = Color3.fromRGB(
				tonumber(hex:sub(1, 2), 16),
				tonumber(hex:sub(3, 4), 16),
				tonumber(hex:sub(5, 6), 16)
			)
		end
		local function emit(a)
			create("Frame", {
				Position = UDim2.new((a.x - 1) / GW, 0, (a.y - 1) / GH, 0),
				Size = UDim2.new(a.w / GW, 1, a.h / GH, 1),
				BackgroundColor3 = colors[a.c],
				BorderSizePixel = 0,
			}, container)
		end
		local active, made = {}, 0
		for y = 1, GH do
			local row, cur, x = rows[y], {}, 1
			while x <= GW do
				local ch, x0 = row:sub(x, x), x
				while x <= GW and row:sub(x, x) == ch do x += 1 end
				local key = x0 .. ":" .. (x - x0) .. ":" .. ch
				local a = active[key]
				if a then
					a.h += 1
					cur[key] = a
				else
					cur[key] = { x = x0, y = y, w = x - x0, h = 1, c = tonumber(ch, 16) }
				end
			end
			for key, a in pairs(active) do
				if not cur[key] then
					emit(a)
					made += 1
				end
			end
			active = cur
			if made > 250 then
				made = 0
				task.wait()
			end
			if not container.Parent then return end
		end
		for _, a in pairs(active) do emit(a) end
	end

	task.spawn(function()
		drawPixels(avatarPixels, FACE_PAL, FACE_ROWS)
		drawPixels(pixelLayer, BG_PAL, BG_ROWS)
	end)
