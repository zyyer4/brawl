local currentTheme = "light"
local function tc(key)
	return THEMES[currentTheme][key] or THEMES.light[key]
end

local bindings = setmetatable({}, { __mode = "k" })
local THEMED_PROPS = {
	BackgroundColor3 = true, TextColor3 = true, TextStrokeColor3 = true,
	Color = true, ScrollBarImageColor3 = true, PlaceholderColor3 = true,
}
local LOOKUP = {
	{ INK, "ink" }, { CREAM, "cream" }, { PINK, "pink" }, { TEAL, "teal" },
	{ COLORS.muted, "muted" }, { COLORS.off, "off" }, { COLORS.bg, "bg" },
	{ Color3.new(1, 1, 1), "white" }, { COLORS.green, "green" }, { COLORS.red, "red" },
	{ THEMES.light.rose, "rose" }, { THEMES.light.aqua, "aqua" }, { THEMES.light.violet, "violet" },
}
local function keyForColor(c, prop)
	for _, e in ipairs(LOOKUP) do
		if e[1] == c then
			local base = e[2]
			if base == "ink" or base == "cream" then
				local kind = prop == "TextColor3" and "t" or (prop == "TextStrokeColor3" and "s" or "b")
				return base .. "_" .. kind
			end
			return base
		end
	end
	return nil
end
registerThemed = function(obj, prop, color)
	if not THEMED_PROPS[prop] then return end
	if prop == "Color" and not obj:IsA("UIStroke") then return end
	local key = keyForColor(color, prop)
	if key then
		bindings[obj] = bindings[obj] or {}
		bindings[obj][prop] = key
	end
end

local function paint(obj, prop, key, dur)
	bindings[obj] = bindings[obj] or {}
	bindings[obj][prop] = key
	local col = tc(key)
	if dur and dur > 0 then
		tween(obj, dur, { [prop] = col })
	else
		obj[prop] = col
	end
end

