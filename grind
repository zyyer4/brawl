------------------------------------------------------------------------
-- Ping helpers
------------------------------------------------------------------------
local pingStatusLabel

local function readPingStat(stat)
	if not stat then return nil end
	local ok, value = pcall(function() return stat:GetValue() end)
	if ok and type(value) == "number" and value >= 0 then return value end
	local okString, valueString = pcall(function() return stat:GetValueString() end)
	if okString and type(valueString) == "string" then
		local number = tonumber(valueString:match("([%d%.]+)"))
		if number then return number end
	end
	return nil
end

local pingStat, lastPingRead = nil, 0

local function findPingStat()
	local network = Stats:FindFirstChild("Network")
	local serverStats = network and network:FindFirstChild("ServerStatsItem")
	local performance = Stats:FindFirstChild("PerformanceStats")
	local candidates = {}
	if serverStats then
		candidates[#candidates + 1] = serverStats:FindFirstChild("Data Ping")
		candidates[#candidates + 1] = serverStats:FindFirstChild("Ping")
	end
	if performance then
		candidates[#candidates + 1] = performance:FindFirstChild("Ping")
	end
	for _, stat in ipairs(candidates) do
		local value = readPingStat(stat)
		if value then
			ping.last = value
			return stat
		end
	end
	return nil
end

local function getPing()
	local now = os.clock()
	if now - lastPingRead < 0.25 then return ping.last end
	lastPingRead = now
	if pingStat then
		local value = readPingStat(pingStat)
		if value then
			ping.last = value
		else
			pingStat = nil
		end
	end
	if not pingStat then pingStat = findPingStat() end
	return ping.last
end

local function updatePingStatus(text)
	if pingStatusLabel then
		local s = string.format("Ping: %d ms | %s", math.floor(getPing() + 0.5), text)
		if pingStatusLabel.Text ~= s then pingStatusLabel.Text = s end
	end
end

local function waitForPingRecovery()
	if ping.pauseDuration > 0 then
		local finish = os.clock() + ping.pauseDuration
		while state.fastRep and ping.enabled and os.clock() < finish do
			updatePingStatus("Paused - cooldown")
			task.wait(0.1)
		end
	end
	while state.fastRep and ping.enabled do
		if getPing() < ping.resumePing then break end
		updatePingStatus("Paused - waiting for recovery")
		task.wait(0.15)
	end
	if state.fastRep then
		updatePingStatus(ping.enabled and "Running" or "Ping adjuster off")
	end
end

------------------------------------------------------------------------
-- Fast rep
------------------------------------------------------------------------
local lastSeatCheck, unseatedSince = 0, nil
local function seatWatchdog()
	if os.clock() - lastSeatCheck < 1 then return end
	lastSeatCheck = os.clock()
	local hum, hrp = getHumanoid(), getRoot()
	if not (hum and hrp) or hum.Health <= 0 then
		unseatedSince = nil
		return
	end
	if hum.Sit or hum.SeatPart ~= nil then
		state.seatedSeen = true
		state.lastSeatCF = hrp.CFrame
		unseatedSince = nil
		return
	end
	if not (state.keepSeated and state.seatedSeen) then return end
	unseatedSince = unseatedSince or os.clock()
	if os.clock() - unseatedSince < 3 then return end
	updatePingStatus("Off the weight - sitting back down")
	local spot = (state.manualOrigin and state.origin) or state.lastSeatCF or state.origin
	if spot and (hrp.Position - spot.Position).Magnitude > CONFIG.ReturnTolerance then
		pcall(function()
			hrp.CFrame = spot
			hrp.Velocity = Vector3.zero
		end)
		task.wait(0.4)
	end
	pressE()
	unseatedSince = os.clock() - 1.5
end

local function fastRepLoop()
	if state.repLoopActive then return end
	state.repLoopActive = true
	local staleSince
	local function step()
		if state.brawlBusy then
			if state.brawlActive then
				staleSince = nil
				if state.brawlStartedAt and state.forceFinish
					and os.clock() - state.brawlStartedAt > CONFIG.MaxBrawlSeconds + 20 then
					task.spawn(state.forceFinish)
				end
			else
				staleSince = staleSince or os.clock()
				if os.clock() - staleSince > 15 then
					state.brawlBusy = false
					staleSince = nil
				end
			end
			updatePingStatus("Paused - brawl")
			task.wait(0.2)
			return
		end
		staleSince = nil
		if ping.enabled and getPing() >= ping.pausePing then
			updatePingStatus("Paused - high ping")
			waitForPingRecovery()
			return
		end
		seatWatchdog()
		updatePingStatus(ping.enabled and "Running" or "Ping adjuster off")
		local batchStart = os.clock()
		while state.fastRep and not state.brawlBusy and os.clock() - batchStart < 0.05 do
			if ping.enabled and getPing() >= ping.pausePing then break end
			for _ = 1, state.repsPerTick do
				if not state.fastRep or state.brawlBusy then break end
				pcall(fireMuscle, muscleEvent, "rep")
			end
			task.wait(0.01)
		end
		task.wait()
	end
	while state.fastRep and gui.Parent do
		local ok, err = pcall(step)
		if not ok then
			warn("[GrindBrawl] fast rep hiccup: " .. tostring(err))
			task.wait(0.5)
		end
	end
	state.repLoopActive = false
	updatePingStatus("Stopped")
end

