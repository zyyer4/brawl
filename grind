		local function flyPtero(dir, y0, z, dur)
			local K = 0.9
			local model = mk("Model", {}, world)
			local body, bone, mem = C(120, 96, 80), C(60, 44, 34), C(176, 116, 72)
			local rig = {}
			local function S(size, col, pos, rot)
				local e = ellipsoid(model, size * K, col, CF(), SMOOTH)
				rig[#rig + 1] = { e, CF(pos * K) * (rot or CF()) }
			end
			S(V3(1.4, 0.5, 0.5), body, V3(0, 0, 0))
			S(V3(0.8, 0.3, 0.3), body, V3(0.95, 0.15, 0))
