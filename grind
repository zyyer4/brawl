		ZIndex = 5,
	}, grip)
	create("UICorner", { CornerRadius = UDim.new(1, 0) }, pill)
	create("UIStroke", { Color = INK, Thickness = 1.5 }, pill)

	local resizing, startY, startH, startPos, dragInput
	local function relax()
		paint(pill, "BackgroundColor3", "pink", 0.15)
		tween(pill, 0.15, { Size = UDim2.fromOffset(54, 6) })
	end
	grip.MouseEnter:Connect(function()
		if not resizing then tween(pill, 0.15, { Size = UDim2.fromOffset(72, 7) }, Enum.EasingStyle.Back) end
	end)
	grip.MouseLeave:Connect(function()
		if not resizing then tween(pill, 0.15, { Size = UDim2.fromOffset(54, 6) }) end
	end)
	grip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			resizing, startY, startH, startPos = true, input.Position.Y, curHeight, root.Position
			paint(pill, "BackgroundColor3", "teal", 0.1)
			tween(pill, 0.15, { Size = UDim2.fromOffset(72, 7) }, Enum.EasingStyle.Back)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					resizing = false
					relax()
				end
			end)
		end
	end)
	grip.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	track(UserInputService.InputChanged:Connect(function(input)
		if resizing and input == dragInput then
			local s = scaler.Scale
			local cam = workspace.CurrentCamera
			local vpY = cam and cam.ViewportSize.Y or 720
			local maxH = math.max(MIN_HEIGHT, math.floor((vpY - 30) / s))
			local newH = math.clamp(startH + (input.Position.Y - startY) / s, MIN_HEIGHT, maxH)
			curHeight = newH
			root.Size = UDim2.fromOffset(WIDTH, newH)
			root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset, startPos.Y.Scale, startPos.Y.Offset + (newH - startH) * s / 2)
		end
	end))
end

