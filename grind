			S(V3(0.9, 0.2, 0.7), pal.acc, V3(0, 1.55, 0.8))
			for i = -1, 1 do S(V3(0.22, 0.7, 0.2), pal.body, V3(i * 0.3, 3.0, 0), ANG(0, 0, rad(-i * 18))) end
		else
			S(V3(1.15, 0.7, 0.9), pal.belly, V3(0, 1.7, 0.7))
			S(V3(0.4, 0.28, 0.28), BLACK, V3(0, 1.95, 1.12))
		end
		for s = -1, 1, 2 do
			S(V3(0.6, 0.6, 0.2), BLACK, V3(0.42 * s, 2.25, 0.66))
			S(V3(0.34, 0.34, 0.12), WHITE, V3(0.42 * s, 2.25, 0.76), nil, NEON) -- the stare
