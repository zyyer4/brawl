local suffixes = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
local function fmt(n)
	n = n or 0
	local sign = n < 0 and "-" or ""
	n = math.abs(n)
	local i = 1
	while n >= 1000 and i < #suffixes do
		n = n / 1000
		i += 1
	end
	if i == 1 then return sign .. string.format("%d", math.floor(n + 0.5)) end
	return sign .. string.format("%.2f%s", n, suffixes[i])
end

local function fmtTime(s)
	s = math.floor(s)
	return string.format("%02d:%02d:%02d", s // 3600, (s % 3600) // 60, s % 60)
end

local function tween(obj, time, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

