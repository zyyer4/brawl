------------------------------------------------------------------------
-- NEW: animated 3D theme scenes (real parts, lit + depth-sorted, drawn in a ViewportFrame)
------------------------------------------------------------------------
do
	local C = Color3.fromRGB
	local V3, CF, ANG = Vector3.new, CFrame.new, CFrame.Angles
	local rad, sin, cos, pi = math.rad, math.sin, math.cos, math.pi
	local kp = NumberSequenceKeypoint.new
	local ck = ColorSequenceKeypoint.new
	local rng = Random.new()
	local NEON, SMOOTH, ICE, SLATE = Enum.Material.Neon, Enum.Material.SmoothPlastic, Enum.Material.Ice, Enum.Material.Slate
	local BASE_VEIL = veilGradient.Transparency
	local SCENE_VEIL = NumberSequence.new({ kp(0, 0.9), kp(1, 0.96) })

	-- plain Instance builder (skips the auto-theming that create() does)
	local function mk(class, props, parent)
		local o = Instance.new(class)
		for k, v in pairs(props) do o[k] = v end
		o.Parent = parent
		return o
	end
	local function pick(list) return list[rng:NextInteger(1, #list)] end

	pixelLayer.ZIndex = 0
	realImage.ZIndex = 0
	scene = mk("Frame", {
		Name = "Scene", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 1, Visible = false, ClipsDescendants = true,
	}, window)
	local bg = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C(255, 255, 255), BorderSizePixel = 0 }, scene)
	local grad = mk("UIGradient", { Rotation = 90 }, bg)
	local layer = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 1 }, scene) -- 2D glows (behind the 3D)
	local overlay = mk("Frame", { Name = "Overlay", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3 }, scene)
	local vp = mk("ViewportFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2,
		Ambient = C(120, 120, 140), LightColor = C(255, 255, 255), LightDirection = V3(-0.5, -1, -0.6),
	}, scene)
	local cam = mk("Camera", { FieldOfView = 40, CFrame = CFrame.lookAt(V3(0, 1.5, 22), V3(0, 0, 0)) }, vp)
	vp.CurrentCamera = cam
	local world = mk("Folder", {}, vp)

	local token = 0
	local anims, P3 = {}, {}
	local lastName

	local function anim(fn) anims[#anims + 1] = fn end
	local function light(amb, col, dir)
		vp.Ambient, vp.LightColor, vp.LightDirection = amb, col, dir
	end
	-- half-width / half-height of the view at z = 0
	local function extent()
		local sz = vp.AbsoluteSize
		if sz.X < 20 or sz.Y < 20 then sz = Vector2.new(WIDTH, curHeight) end
		local h = math.tan(rad(cam.FieldOfView / 2)) * 22
		return h * sz.X / sz.Y, h
	end

	----------------------------------------------------------------
	-- 3D primitives
	----------------------------------------------------------------
	local function basePart(class, parent, size, col, cf, mat, tr)
		local p = Instance.new(class)
		p.Anchored, p.CanCollide, p.CastShadow = true, false, false
		p.Size, p.Color, p.CFrame = size, col, cf or CF()
		p.Material = mat or SMOOTH
		p.Transparency = tr or 0
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.Parent = parent
		return p
	end
	local function ellipsoid(parent, size, col, cf, mat, tr)
		local p = basePart("Part", nil, size, col, cf, mat, tr)
		mk("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, p)
		p.Parent = parent
		return p
	end
	local function box(parent, size, col, cf, mat, tr)
		return basePart("Part", parent, size, col, cf, mat, tr)
	end
	local function cyl(parent, size, col, cf, mat, tr) -- axis = local X
		local p = basePart("Part", parent, size, col, cf, mat, tr)
		p.Shape = Enum.PartType.Cylinder
		return p
	end

	-- PART A — quality scaling, richer particles, camera hooks
	------------------------------------------------------------------------
	local UIS = game:GetService("UserInputService")
	local V2 = Vector2.new
	local QUALITY = (UIS.TouchEnabled and not UIS.KeyboardEnabled) and 0.6 or 1
	local function qn(n) return math.max(1, math.floor(n * QUALITY + 0.5)) end
	local PCAP = math.floor(260 * QUALITY + 0.5)
	local camFn, shakeAmt = nil, 0
	local function shake(a) shakeAmt = math.max(shakeAmt, a) end
	
	-- 3D particles.  Fields: pos vel acc size col mat life grow shrink fadeAt spin
	--                        col2 (colour over life)  drag  stretch (streak along velocity)
	local function emit(o)
		if #P3 >= PCAP then return end
		local s = o.size or 0.2
		local sz = typeof(s) == "Vector3" and s or V3(s, s, s)
		o.base, o.age, o.life = sz, 0, o.life or 1
		o.col0 = o.col or C(255, 255, 255)
		o.part = ellipsoid(world, sz, o.col0, CF(o.pos), o.mat or NEON)
		P3[#P3 + 1] = o
	end
	local function stepParticles(dt)
		for i = #P3, 1, -1 do
			local o = P3[i]
			o.age += dt
			local f = o.age / o.life
			if f >= 1 or not o.part.Parent then
				o.part:Destroy()
				table.remove(P3, i)
			else
				if o.drag then o.vel *= math.max(0, 1 - o.drag * dt) end
				o.pos += o.vel * dt
				if o.acc then o.vel += o.acc * dt end
				local cf
				if o.stretch and o.vel.Magnitude > 0.01 then
					cf = CFrame.lookAt(o.pos, o.pos + o.vel)
				else
					cf = CF(o.pos)
				end
				if o.spin then cf = cf * ANG(o.spin.X * o.age, o.spin.Y * o.age, o.spin.Z * o.age) end
				o.part.CFrame = cf
				local fa = o.fadeAt or 0.35
				o.part.Transparency = math.clamp((f - fa) / (1 - fa), 0, 1)
				local sc = math.max((1 + (o.grow or 0) * f) * (1 - (o.shrink or 0) * f), 0.01)
				if o.stretch then
					o.part.Size = V3(o.base.X * sc, o.base.Y * sc, o.base.Z * sc * o.stretch)
				elseif o.grow or o.shrink then
					o.part.Size = o.base * sc
				end
				if o.col2 then o.part.Color = o.col0:Lerp(o.col2, f) end
			end
		end
	end


	-- run fn every `interval` seconds while this scene is still the active one
	local function every(tk, interval, fn, waitFirst)
		task.spawn(function()
			local function iv() return type(interval) == "function" and interval() or interval end
			if waitFirst then task.wait(iv()) end
			while token == tk and gui.Parent do
				if gui.Enabled then
					local ok, err = pcall(fn)
					if not ok then warn("[GrindBrawl] scene: " .. tostring(err)) end
				end
				task.wait(iv())
			end
		end)
	end
	local function loopTween(obj, t, goal, style)
		TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), goal):Play()
	end

	-- PART B — shared render loop (camera override + screen shake)
	------------------------------------------------------------------------
	do
		local acc = 0
		track(RunService.Heartbeat:Connect(function(dt)
			if not (scene.Visible and gui.Enabled) then return end
			acc += dt
			if acc < 1 / 30 then return end
			local step = math.min(acc, 0.1)
			acc = 0
			local t = os.clock()
			if camFn then
				camFn(t, step)
			else
				cam.CFrame = CFrame.lookAt(V3(sin(t * 0.35) * 0.7, 1.4 + sin(t * 0.27) * 0.3, 22), V3(0, 0, 0))
			end
			if shakeAmt > 0.003 then
				local s = shakeAmt
				cam.CFrame = cam.CFrame * CF(rng:NextNumber(-s, s), rng:NextNumber(-s, s), 0)
				shakeAmt *= 0.84
			else
				shakeAmt = 0
			end
			stepParticles(step)
			for i = #anims, 1, -1 do
				local ok, keep = pcall(anims[i], step, t)
				if not ok or keep == false then table.remove(anims, i) end
			end
		end))
	end

	----------------------------------------------------------------
	-- 3D dragon (built from ellipsoids, animated wings + tail)
	----------------------------------------------------------------
	local function dragon3d(pal)
		local K = 0.55
		local function Z(x, y, z) return V3(x, y, z) * K end
		local function L(x, y, z) return CF(x * K, y * K, z * K) end
		local model = mk("Model", {}, world)
		local rig = {}
		local function S(size, col, lcf, mat)
			local p = ellipsoid(model, size, col, CF(), mat)
			rig[#rig + 1] = { p, lcf }
			return p
		end
		S(Z(2.8, 1.3, 1.3), pal.body, L(0, 0, 0))
		S(Z(2.3, 0.7, 1.0), pal.belly, L(0.2, -0.4, 0))
		S(Z(1.5, 1.1, 1.1), pal.body, L(1.1, 0.05, 0))
		S(Z(1.5, 0.5, 0.55), pal.body, L(1.9, 0.55, 0) * ANG(0, 0, rad(30)))
		S(Z(1.1, 0.75, 0.8), pal.body, L(2.6, 0.95, 0))
		S(Z(0.9, 0.4, 0.5), pal.body, L(3.15, 0.85, 0))
		S(Z(0.7, 0.15, 0.4), pal.belly, L(3.1, 0.62, 0))
		for sgn = -1, 1, 2 do
			S(Z(0.2, 0.2, 0.2), pal.glow, L(2.85, 1.12, 0.3 * sgn), NEON)
			S(Z(0.9, 0.16, 0.16), pal.horn, L(2.3, 1.38, 0.22 * sgn) * ANG(0, 0, rad(35)))
			S(Z(0.5, 0.35, 0.3), pal.body, L(0.7, -0.75, 0.45 * sgn))
			S(Z(0.5, 0.35, 0.3), pal.body, L(-0.7, -0.75, 0.45 * sgn))
		end
		for i = 1, 5 do
			S(Z(0.35, 0.42, 0.14), pal.horn, L(1.4 - i * 0.55, 0.72, 0) * ANG(0, 0, rad(-12)))
		end
		local tail = {}
		for i = 1, 8 do
			local s = math.max(0.14, 0.85 - i * 0.09)
			tail[i] = ellipsoid(model, Z(0.8, s, s), i % 3 == 0 and pal.horn or pal.body, CF())
		end
		local tip = ellipsoid(model, Z(0.45, 0.45, 0.45), pal.glow, CF(), NEON)

		local wings = {}
		local MEM = {
			{ V3(-0.7, 0, 0.7), V3(1.7, 0.05, 1.2) },
			{ V3(-0.55, 0, 1.7), V3(1.35, 0.05, 1.1) },
			{ V3(-0.3, 0, 2.5), V3(0.8, 0.05, 0.9) },
		}
		for sgn = -1, 1, 2 do
			local w = { s = sgn, mem = {} }
			w.bone = ellipsoid(model, Z(0.2, 0.2, 2.9), pal.horn, CF())
			w.finger = ellipsoid(model, Z(1.5, 0.12, 0.12), pal.horn, CF())
			for _, m in ipairs(MEM) do
				w.mem[#w.mem + 1] = { p = ellipsoid(model, m[2] * K, pal.wing, CF(), SMOOTH, 0.06), pos = m[1] }
			end
			wings[#wings + 1] = w
		end

		local function update(root, t, speed)
			for _, e in ipairs(rig) do e[1].CFrame = root * e[2] end
			for i, p in ipairs(tail) do
				p.CFrame = root * L(-1.2 - i * 0.62, sin(t * 5 - i * 0.8) * 0.1 * i, cos(t * 3 - i * 0.6) * 0.09 * i)
			end
			tip.CFrame = root * L(-1.2 - 9 * 0.62, sin(t * 5 - 7.2) * 0.9, cos(t * 3 - 5.4) * 0.8)
			local a = sin(t * speed) * 0.7 + 0.2
			for _, w in ipairs(wings) do
				local s = w.s
				local base = root * L(0.4, 0.55, 0.5 * s) * ANG(-a * s, 0, 0)
				w.bone.CFrame = base * L(-0.2, 0, 1.4 * s)
				w.finger.CFrame = base * L(-1.0, 0, 1.3 * s) * ANG(0, 0.5 * s, 0)
				for _, m in ipairs(w.mem) do
					m.p.CFrame = base * L(m.pos.X, 0, m.pos.Z * s)
				end
			end
		end
		return { model = model, update = update, K = K }
	end

	local function flyDragon(pal, dir, y, z, dur, breath)
		local d = dragon3d(pal)
		local hw = extent() + 5
		local t0 = os.clock()
		anim(function(_, t)
			local a = (t - t0) / dur
			if a >= 1 then
				d.model:Destroy()
				return false
			end
			local x = dir * (-hw + 2 * hw * a)
			local yaw = dir == 1 and -0.5 or pi + 0.5
			local root = CF(x, y + sin(a * pi * 3) * 0.5, z) * ANG(0, yaw, 0) * ANG(sin(t * 2) * 0.08, 0, cos(a * pi * 3) * 0.1)
			d.update(root, t, 9)
			local mp = (root * CF(3.5 * d.K, 0.8 * d.K, 0)).Position
			local fwd = root.RightVector
			for _ = 1, 2 do
				emit({
					pos = mp,
					vel = fwd * rng:NextNumber(5, 8) + V3(rng:NextNumber(-1, 1), rng:NextNumber(-0.5, 1.5), rng:NextNumber(-1, 1)),
					size = rng:NextNumber(0.2, 0.45), col = pick(breath), life = 0.7, grow = 2,
				})
			end
		end)
	end

	local LAVA_PAL = { body = C(170, 34, 22), belly = C(255, 170, 70), wing = C(210, 60, 30), horn = C(60, 20, 16), glow = C(255, 230, 90) }
	local ICE_PAL = { body = C(90, 160, 220), belly = C(225, 245, 255), wing = C(140, 210, 250), horn = C(235, 250, 255), glow = C(120, 255, 255) }

	----------------------------------------------------------------
	-- 3D goblin (hunter) / floating sword (murim) / rocket (space)
	----------------------------------------------------------------
	local function goblin3d()
		local model = mk("Model", {}, world)
