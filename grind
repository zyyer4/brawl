local registerThemed
local function create(className, props, parent)
	local obj = Instance.new(className)
	for k, v in pairs(props or {}) do
		obj[k] = v
		if registerThemed and typeof(v) == "Color3" then registerThemed(obj, k, v) end
	end
	obj.Parent = parent
	return obj
end

