		local function nang(a, ox, oy) return math.atan2(sin(a) / (ry + oy), cos(a) / (rx + ox)) end

		local halo = ellipsoid(world, V3(rx * 2 + 2.8, ry * 2 + 2.8, 0.2), C(120, 120, 255), CF(gx, gy, gz - 0.5), NEON, 0.88)
		ellipsoid(world, V3(rx * 2, ry * 2, 0.3), C(5, 3, 22), CF(gx, gy, gz), SMOOTH)
		local core = ellipsoid(world, V3(rx * 1.4, ry * 1.4, 0.2), C(70, 70, 235), CF(gx, gy, gz + 0.12), NEON, 0.55)
		local eye = ellipsoid(world, V3(rx * 0.55, ry * 0.5, 0.2), ICEW, CF(gx, gy, gz + 0.2), NEON, 0.65)

		local ringA, ringB, spiral, runes, circ, debris, rays = {}, {}, {}, {}, {}, {}, {}
		for i = 1, 40 do ringA[i] = { p = ellipsoid(world, V3(0.3, 0.3, 0.3), i % 2 == 0 and BLU or VIO, CF(), NEON), a = i / 40 * 2 * pi } end
		for i = 1, 28 do ringB[i] = { p = ellipsoid(world, V3(0.2, 0.2, 0.2), i % 2 == 0 and ICEW or VIO, CF(), NEON), a = i / 28 * 2 * pi } end
		for k = 1, 30 do spiral[k] = ellipsoid(world, V3(0.15, 0.15, 0.15), k % 2 == 0 and C(150, 120, 255) or C(120, 220, 255), CF(), NEON) end
		for i = 1, 26 do circ[i] = { p = ellipsoid(world, V3(0.18, 0.18, 0.18), i % 2 == 0 and VIO or BLU, CF(), NEON), a = i / 26 * 2 * pi } end
		for i = 1, 9 do rays[i] = box(world, V3(0.1, ry * 3.4, 0.05), C(130, 140, 255), CF(gx, gy, gz - 0.9), NEON, 0.86) end
		local pad = ellipsoid(world, V3(rx * 3.6, 0.06, 4.8), C(110, 90, 255), CF(gx + 0.8, ground + 0.04, gz + 1.4), NEON, 0.65)

		-- obsidian shards around the frame + pulsing runes
		for i = 1, 16 do
			local a = (i - 0.5) / 16 * 2 * pi
			if sin(a) > -0.88 then
				local h = rng:NextNumber(1.4, 2.8)
				local n = nang(a, 1.1, 1.1)
				local base = ep(a, 1.1, 1.1, gz + rng:NextNumber(-0.4, 0.2))
				local dir = V3(cos(n), sin(n), 0)
				box(world, V3(0.5, h, 0.45), C(16, 14, 40), CF(base + dir * (h / 2)) * ANG(0, 0, n - pi / 2 + rng:NextNumber(-0.12, 0.12)) * ANG(0, rad(30), 0), SLATE)
				local tip = ellipsoid(world, V3(0.2, 0.34, 0.2), i % 2 == 0 and BLU or VIO, CF(base + dir * h), NEON)
				local ph = rng:NextNumber(0, 6)
				anim(function(_, t) tip.Transparency = 0.1 + 0.4 * (sin(t * 2.5 + ph) + 1) / 2 end)
			end
		end
		for i = 1, 14 do
			local a = (i - 0.5) / 14 * 2 * pi
			if sin(a) > -0.8 then
				local n = nang(a, 0.75, 0.75)
				runes[#runes + 1] = { p = box(world, V3(0.5, 0.15, 0.06), ICEW, CF(ep(a, 0.75, 0.75, gz + 0.1)) * ANG(0, 0, n + pi / 2), NEON), i = i }
			end
		end
		for i = 1, 7 do
			debris[i] = {
				p = box(world, V3(0.3, 0.3, 0.3) * rng:NextNumber(0.6, 1.6), C(20, 18, 44), CF(), SLATE),
				a = rng:NextNumber(0, 2 * pi), r = rng:NextNumber(0.4, 1.0), ph = rng:NextNumber(0, 6), s = rng:NextNumber(0.2, 0.5),
			}
		end

		anim(function(dt, t)
			flare = math.max(0, flare - dt * 2)
			halo.Transparency = math.clamp(0.86 - 0.07 * sin(t * 2.2) - 0.3 * flare, 0, 1)
			core.Transparency = math.clamp(0.58 + 0.1 * sin(t * 3) - 0.35 * flare, 0, 1)
			eye.Transparency = math.clamp(0.7 + 0.15 * sin(t * 4.1) - 0.3 * flare, 0, 1)
			for _, r in ipairs(ringA) do
				r.p.Position = ep(r.a + t * 0.7, 0, 0, gz + 0.22)
				local s = 0.26 + 0.12 * sin(t * 4 + r.a * 3) + 0.18 * flare
				r.p.Size = V3(s, s, s)
			end
			for _, r in ipairs(ringB) do
				r.p.Position = ep(r.a - t * 1.1, 0.32, 0.32, gz + 0.18)
				local s = 0.18 + 0.06 * sin(t * 5 + r.a * 2)
				r.p.Size = V3(s, s, s)
			end
			for k, s in ipairs(spiral) do
				local m, j = (k - 1) % 3, (k - 1) // 3 + 1
				local fr = j / 10
				local a = fr * 3.4 + t * 2.4 + m * 2.0944
				s.Position = V3(gx + cos(a) * fr * (rx - 0.25), gy + sin(a) * fr * (ry - 0.25), gz + 0.28)
				local z = 0.08 + 0.12 * fr
				s.Size = V3(z, z, z)
			end
			for _, r in ipairs(runes) do r.p.Transparency = 0.15 + 0.7 * (0.5 + 0.5 * sin(t * 3 - r.i * 0.8)) end
			for i, r in ipairs(rays) do
				r.CFrame = CF(gx, gy, gz - 0.9) * ANG(0, 0, t * 0.12 + i * pi / 9)
				r.Transparency = math.clamp(0.84 + 0.1 * sin(t * 1.5 + i) - 0.1 * flare, 0, 1)
			end
			for _, c in ipairs(circ) do
				local a = c.a - t * 0.5
				c.p.Position = V3(gx + 0.8 + cos(a) * 4.6, ground + 0.07, gz + 1.4 + sin(a) * 2.3)
			end
			pad.Transparency = math.clamp(0.68 + 0.1 * sin(t * 2) - 0.2 * flare, 0, 1)
			for _, d in ipairs(debris) do
				local a = d.a + t * d.s * 0.4
				d.p.CFrame = CF(gx + cos(a) * (rx + 1.2 + d.r * 2), gy + sin(a) * (ry + 1.0 + d.r * 1.5) + sin(t + d.ph) * 0.2, gz - 0.3 + sin(a)) * ANG(t * 0.7, t * 0.5, d.ph)
			end
		end)

		-- lightning crackling off the rim
		every(tk, function() return rng:NextNumber(0.5, 1.3) end, function()
			local p0 = ep(rng:NextNumber(0, 2 * pi), 0.2, 0.2, gz + 0.3)
			bolt(p0, p0 + V3(rng:NextNumber(-2.6, 2.6), rng:NextNumber(-2.6, 2.6), 0), pick({ C(150, 190, 255), C(200, 160, 255) }), 0.22, 5, 0.4, 0.07)
		end)

		-- ===== the fight =====
		local hx = hw * 0.55
		local hunter = hunter3d()
		local hs = { x = hx, run = 0, slashT0 = -10, side = 1 }
		local goblins, shadows = {}, {}
		local SLASH_DUR = 0.4

		local function spawnGoblin()
			if #goblins >= 4 then return end
			local g = goblin3d()
			goblins[#goblins + 1] = {
				g = g, parts = g.model:GetChildren(), x = gx + 0.4, speed = rng:NextNumber(3.6, 5),
				ph = rng:NextNumber(0, 6), born = os.clock(), pos = V3(gx + 0.4, ground + 1, gz + 0.6),
			}
			flare = 1
			flash.BackgroundTransparency = 0.9
			tween(flash, 0.4, { BackgroundTransparency = 1 })
			for _ = 1, 10 do
				local a = rng:NextNumber(0, 2 * pi)
				emit({ pos = V3(gx + cos(a) * rx * 0.8, gy + sin(a) * ry * 0.8, gz + 0.3), vel = V3(cos(a) * 2.5 + 3, sin(a) * 2, rng:NextNumber(0, 1.5)), size = 0.14, col = pick({ BLU, VIO }), life = 0.9, grow = 1.5 })
			end
		end

		local function arise(pos)
			if #shadows >= 2 then return end
			local g = goblin3d()
			for _, p in ipairs(g.model:GetChildren()) do
				if p.Material == NEON then
					p.Color = C(190, 120, 255)
				else
					p.Color = C(24, 10, 60)
					p.Transparency = 0.15
				end
			end
			shadows[#shadows + 1] = { g = g, x = pos.X, ph = rng:NextNumber(0, 6), born = os.clock(), life = rng:NextNumber(6, 9) }
		end

		anim(function(dt, t)
			-- pick the goblin closest to the hunter
			local target, bestD
			for _, o in ipairs(goblins) do
				if not o.hitAt and o.x > gx + 1.2 then
					local d = math.abs(hs.x - o.x)
					if not bestD or d < bestD then target, bestD = o, d end
				end
			end
			local want = hx
			if target then want = math.min(hx, math.max(gx + 4.2, target.x + 2.4)) end
			local dx = want - hs.x
			hs.x += math.clamp(dx, -10 * dt, 10 * dt)
			hs.run += ((math.abs(dx) > 0.25 and 1 or 0) - hs.run) * math.min(1, dt * 12)
			if target and t - hs.slashT0 > SLASH_DUR + 0.04 and (hs.x - target.x) < 3.2 then
				hs.slashT0, hs.side = t, -hs.side
				target.hitAt = t + SLASH_DUR * 0.45
			end
			local e = (t - hs.slashT0) / SLASH_DUR
			local slash = (e >= 0 and e <= 1) and e or nil
			local lunge = slash and sin(slash * pi) * 0.7 or 0
			local root = CF(hs.x, ground + 2.3 + math.abs(sin(t * 13)) * 0.12 * hs.run, 0.2) * ANG(0, pi + 0.2, 0) * CF(lunge, 0, 0)
			local tip = hunter.update(root, t, hs.run, slash, hs.side)
			if tip then emit({ pos = tip, vel = V3(0, 0, 0), size = 0.22, col = VIO, life = 0.35, grow = 0.6 }) end

			for i = #goblins, 1, -1 do
				local o = goblins[i]
				if o.hitAt and t >= o.hitAt then
					local p = o.pos + V3(0, 1, 0)
					emit({ pos = p, vel = V3(0, 0, 0), size = 0.9, col = C(255, 255, 255), life = 0.18, grow = 2.5, fadeAt = 0 })
					for _ = 1, 12 do
						emit({ pos = p, vel = V3(rng:NextNumber(-5, 5), rng:NextNumber(-1, 6), rng:NextNumber(-2, 2)), acc = V3(0, -9, 0), size = rng:NextNumber(0.1, 0.3), col = pick({ C(170, 120, 255), C(110, 160, 255), C(255, 255, 255) }), life = 0.8, grow = 0.5 })
					end
					for _ = 1, 6 do
						emit({ pos = p + V3(rng:NextNumber(-0.5, 0.5), -0.8, 0), vel = V3(rng:NextNumber(-0.3, 0.3), rng:NextNumber(1.5, 3), 0), size = rng:NextNumber(0.25, 0.45), col = C(40, 20, 90), mat = SMOOTH, life = 1.6, fadeAt = 0.4 })
					end
					bolt(p + V3(1.6, 1.8, 0.3), p + V3(-1.6, -1.2, 0.3), C(225, 205, 255), 0.2, 3, 0.25, 0.12)
					if rng:NextNumber() < 0.4 then arise(o.pos) end
					o.g.model:Destroy()
					table.remove(goblins, i)
				else
					o.x += o.speed * dt * (o.hitAt and 0.3 or 1)
					local prog = math.clamp((o.x - gx) / (rx + 1.2), 0, 1)
					local z = (gz + 0.6) + (-0.1 - (gz + 0.6)) * prog
					o.pos = V3(o.x, ground + 1.0 + math.abs(sin(t * 7 + o.ph)) * 0.35, z)
					o.g.update(CF(o.pos) * ANG(0, rad(-10), 0), t)
					local age = t - o.born
					if age < 0.4 then
						for _, p in ipairs(o.parts) do p.Transparency = 1 - age / 0.4 end
					elseif not o.solid then
						o.solid = true
						for _, p in ipairs(o.parts) do p.Transparency = 0 end
					end
				end
			end

			for i = #shadows, 1, -1 do
				local s = shadows[i]
				if t - s.born > s.life or not s.g.model.Parent then
					for _ = 1, 8 do
						emit({ pos = V3(s.x, ground + 1.2, 0), vel = V3(rng:NextNumber(-1, 1), rng:NextNumber(1, 3), 0), size = 0.2, col = VIO, life = 0.8 })
					end
					s.g.model:Destroy()
					table.remove(shadows, i)
				else
					local tx = hs.x + 2.2 + i * 1.3
					s.x += (tx - s.x) * math.min(1, dt * 3)
					local moving = math.abs(tx - s.x) > 0.3
					s.g.update(CF(s.x, ground + 1.0 + (moving and math.abs(sin(t * 8 + s.ph)) * 0.35 or 0), -0.3 + i * 0.35) * ANG(0, pi + 0.15, 0), moving and t or 0)
				end
			end
		end)

		every(tk, 0.12, function() -- shadow aura around the hunter
			emit({ pos = V3(hs.x + rng:NextNumber(-0.6, 0.6), ground + 0.3, 0.2), vel = V3(0, rng:NextNumber(1.5, 3), 0), size = rng:NextNumber(0.08, 0.2), col = pick({ VIO, BLU }), life = 1.3, fadeAt = 0.4 })
		end)
		task.delay(0.6, function() if token == tk then spawnGoblin() end end)
		every(tk, function() return rng:NextNumber(1.3, 2.4) end, spawnGoblin, true)
	end

	----------------------------------------------------------------
	-- JUNGLE: Jurassic-style valley (T-rex, raptors, brachiosaurus, pterosaurs)
