			emit({ pos = (root * CF(-1.1, 0, 0)).Position, vel = -root.RightVector * 2 + V3(0, rng:NextNumber(-0.3, 0.3), 0),
				size = 0.18, col = pick({ C(255, 170, 70), C(255, 230, 140) }), life = 0.6, grow = 1.5 })
		end)
	end

