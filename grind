	local function slashAng(e)
		if e < 0.25 then return 1.1 + 1.5 * (e / 0.25) end
		return 2.6 - 2.4 * math.sqrt((e - 0.25) / 0.75)
	end

	local function hunter3d()
		local K = 1.5
		local model = mk("Model", {}, world)
		local rig, legs, arms, tails = {}, {}, {}, {}
		local coat, dark, skin, hair = C(46, 42, 86), C(14, 12, 30), C(238, 206, 184), C(8, 6, 16)
		local function S(size, col, pos, rot, mat)
			local p = ellipsoid(model, size * K, col, CF(), mat)
			rig[#rig + 1] = { p, CF(pos * K) * (rot or CF()) }
			return p
		end
		S(V3(0.72, 1.0, 0.86), coat, V3(0, 0.1, 0))
		S(V3(0.78, 0.62, 1.0), coat, V3(0, 0.62, 0))
		S(V3(0.52, 0.22, 0.56), dark, V3(0.02, 0.98, 0))
		S(V3(0.8, 0.14, 0.9), dark, V3(0, -0.3, 0))
		S(V3(0.56, 0.62, 0.56), skin, V3(0.04, 1.3, 0))
		S(V3(0.64, 0.4, 0.62), hair, V3(-0.04, 1.52, 0))
		S(V3(0.36, 0.34, 0.58), hair, V3(-0.3, 1.36, 0))
		S(V3(0.26, 0.2, 0.6), hair, V3(0.2, 1.58, 0), ANG(0, 0, rad(-20)))
		for s = -1, 1, 2 do
			S(V3(0.1, 0.08, 0.14), C(206, 140, 255), V3(0.31, 1.3, 0.14 * s), nil, NEON)
			legs[#legs + 1] = {
				s = s,
				p = ellipsoid(model, V3(0.34, 1.05, 0.34) * K, dark, CF()),
				boot = ellipsoid(model, V3(0.58, 0.22, 0.4) * K, dark, CF()),
			}
			arms[#arms + 1] = {
				s = s,
				p = ellipsoid(model, V3(0.28, 0.95, 0.28) * K, coat, CF()),
				grip = ellipsoid(model, V3(0.2, 0.2, 0.2) * K, dark, CF()),
				blade = box(model, V3(0.06, 1.2, 0.2) * K, C(176, 120, 255), CF(), NEON),
			}
			tails[#tails + 1] = { s = s, p = ellipsoid(model, V3(0.34, 1.0, 0.3) * K, coat, CF()) }
		end
		-- run: 0..1 blend, slash: 0..1 phase or nil, side: which arm slashes. Returns the blade tip while slashing.
		local function update(root, t, run, slash, side)
			for _, e in ipairs(rig) do e[1].CFrame = root * e[2] end
			for _, l in ipairs(legs) do
				local ang = 0.28 * l.s * (1 - run) + sin(t * 13 + (l.s == 1 and 0 or pi)) * 0.85 * run
				local hip = root * CF(0, -0.42 * K, 0.24 * K * l.s) * ANG(0, 0, ang)
				l.p.CFrame = hip * CF(0, -0.52 * K, 0)
				l.boot.CFrame = hip * CF(0.12 * K, -1.02 * K, 0)
			end
			local tip
			for _, a in ipairs(arms) do
				local idle = (a.s == side and 1.15 or 0.7) + sin(t * 2) * 0.05
				local th = idle * (1 - run) + (0.55 + sin(t * 13 + (a.s == 1 and pi or 0)) * 0.8) * run
				if slash then th = (a.s == side) and slashAng(slash) or 0.9 end
				local sh = root * CF(0, 0.72 * K, 0.56 * K * a.s) * ANG(0, 0, th)
				a.p.CFrame = sh * CF(0, -0.45 * K, 0)
				a.grip.CFrame = sh * CF(0, -0.95 * K, 0)
				a.blade.CFrame = sh * CF(0, -1.6 * K, 0)
				if slash and a.s == side then tip = (sh * CF(0, -2.2 * K, 0)).Position end
			end
			for _, c in ipairs(tails) do
				local sw = -(0.12 + run * 0.55 + sin(t * 6 + c.s) * 0.07)
				c.p.CFrame = root * CF(-0.3 * K, -0.35 * K, 0.26 * K * c.s) * ANG(0, 0, sw) * CF(0, -0.45 * K, 0)
			end
			return tip
		end
		return { model = model, update = update }
	end

	----------------------------------------------------------------
	-- generic two-legged dino (T-rex / raptor). Faces local +X.
	----------------------------------------------------------------
	local function theropod(pal, p)
		local K, f, hd = p.K, p.fat, p.head
		local model = mk("Model", {}, world)
		local rig, tail, legs = {}, {}, {}
		local function S(size, col, pos, rot, mat)
			local e = ellipsoid(model, size * K, col, CF(), mat)
			rig[#rig + 1] = { e, CF(pos * K) * (rot or CF()) }
			return e
		end
		S(V3(3.2, 1.9 * f + 0.3, 1.5 * f + 0.2), pal.body, V3(0, 0, 0))
		S(V3(2.4, 0.8 * f + 0.2, 1.2 * f + 0.1), pal.belly, V3(0.15, -0.5 * f - 0.05, 0))
		S(V3(1.6, 1.5 * f + 0.2, 1.3 * f + 0.1), pal.body, V3(1.1, 0.2, 0))
		S(V3(1.5, 0.8 * f + 0.2, 0.7 * f + 0.15), pal.body, V3(1.9, 0.9, 0), ANG(0, 0, rad(35)))
		for i = 1, 4 do
			S(V3(0.55, 0.25, 0.5 * f + 0.1), pal.stripe, V3(1.2 - i * 0.55, 0.9 * f + 0.15, 0))
		end
		local H = V3(2.5 + 0.4 * hd, 1.35, 0)
		S(V3(1.9, 1.0, 0.95) * hd, pal.body, H)
		S(V3(1.0, 0.6, 0.7) * hd, pal.body, H + V3(0.85 * hd, -0.05, 0))
		for s = -1, 1, 2 do
			S(V3(0.2, 0.2, 0.12) * hd + V3(0.04, 0.04, 0.04), pal.eye, H + V3(0.35 * hd, 0.3 * hd, 0.44 * hd * s), nil, NEON)
			S(V3(0.5, 0.18, 0.18) * p.arm, pal.body, V3(1.55, -0.55 * f - 0.15, (0.7 * f + 0.05) * s), ANG(0, 0, rad(-35)))
		end
		local jaw = ellipsoid(model, V3(1.5, 0.3, 0.6) * hd * K, pal.belly, CF())
		for i = 1, p.tailN do
			local sz = math.max(0.12, (0.9 * f + 0.1) * (1 - i / (p.tailN + 1)))
			tail[i] = ellipsoid(model, V3(0.9, sz, sz) * K, i % 2 == 0 and pal.stripe or pal.body, CF())
		end
		for s = -1, 1, 2 do
			legs[#legs + 1] = {
				s = s,
				th = ellipsoid(model, V3(0.85 * f + 0.15, p.l1 * 1.1, 0.7 * f + 0.15) * K, pal.body, CF()),
				sh = ellipsoid(model, V3(0.4, p.l2 * 1.1, 0.4) * K, pal.body, CF()),
				ft = box(model, V3(0.9, 0.2, 0.45) * K, pal.belly, CF()),
			}
		end
		local function update(root, t, open)
			for _, e in ipairs(rig) do e[1].CFrame = root * e[2] end
			for i, e in ipairs(tail) do
				e.CFrame = root * CF((-1.3 - i * p.tailStep) * K, ((0.15 - i * 0.04) + sin(t * 3 - i * 0.7) * 0.03 * i) * K, sin(t * p.speed * 0.5 - i * 0.6) * 0.07 * i * K)
			end
			jaw.CFrame = root * CF((H.X - 0.1 * hd) * K, (H.Y - 0.42 * hd) * K, 0) * ANG(0, 0, -(open or 0)) * CF(0.5 * hd * K, -0.04 * K, 0)
			for _, l in ipairs(legs) do
				local ph = t * p.speed + (l.s == 1 and 0 or pi)
				local hip = root * CF(-0.2 * K, -0.6 * K, (0.7 * f + 0.05) * K * l.s) * ANG(0, 0, sin(ph) * p.swing)
				l.th.CFrame = hip * CF(0, -p.l1 * 0.5 * K, 0)
				local knee = hip * CF(0, -p.l1 * K, 0) * ANG(0, 0, -math.max(0, cos(ph)) * 0.9 - 0.15)
				l.sh.CFrame = knee * CF(0, -p.l2 * 0.5 * K, 0)
				l.ft.CFrame = knee * CF(0.3 * K, -(p.l2 + 0.05) * K, 0)
			end
		end
		return { model = model, update = update, h = (0.6 + p.l1 + p.l2 + 0.15) * K }
	end

