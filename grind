			if a >= 1 then model:Destroy() return false end
			local root = CF(-hw + 2 * hw * a, y0 + sin(a * pi * 2) * 0.8, -2) * ANG(rad(10), rad(-25), rad(8) + cos(a * pi * 2) * 0.12)
