			S(V3(1.1, 0.12, 0.12), body, V3(-1.0, -0.05, 0))
			local wings = {}
			for s = -1, 1, 2 do
				wings[#wings + 1] = {
					s = s,
					a = ellipsoid(model, V3(1.3, 0.05, 2.0) * K, mem, CF(), SMOOTH),
					b = ellipsoid(model, V3(0.9, 0.04, 1.8) * K, mem, CF(), SMOOTH),
					bone = ellipsoid(model, V3(0.08, 0.08, 3.4) * K, bone, CF(), SMOOTH),
				}
			end
			local hw2 = extent() + 5
			local t0 = os.clock()
			anim(function(_, t)
				local a = (t - t0) / dur
				if a >= 1 then model:Destroy() return false end
				local x = dir * (-hw2 + 2 * hw2 * a)
				local root = CF(x, y0 + sin(a * pi * 2) * 0.6, z) * ANG(0, dir == 1 and 0 or pi, 0) * ANG(cos(a * pi * 2) * 0.15, 0, 0)
				for _, e in ipairs(rig) do e[1].CFrame = root * e[2] end
				local f = sin(t * 7) * 0.7
				for _, w in ipairs(wings) do
					local s = w.s
					local base = root * CF(0, 0.1 * K, 0.3 * K * s) * ANG(f * s, 0, 0)
					w.a.CFrame = base * CF(-0.1 * K, 0, 1.0 * K * s)
					w.bone.CFrame = base * CF(0.5 * K, 0.02, 1.7 * K * s)
					w.b.CFrame = base * CF(0.3 * K, 0, 2.0 * K * s) * ANG(f * 0.6 * s, 0, 0) * CF(-0.1 * K, 0, 0.8 * K * s)
				end
			end)
		end

