			S(V3(0.8, 1.6, 0.8), pal.body, V3(0.5 * s, -2.0, 0))
			S(V3(0.9, 0.3, 1.1), pal.body, V3(0.5 * s, -2.9, 0.15))
			if kind == "freddy" then
				S(V3(0.7, 0.7, 0.3), pal.body, V3(0.85 * s, 2.85, 0))
				S(V3(0.4, 0.4, 0.12), pal.belly, V3(0.85 * s, 2.85, 0.12))
			elseif kind == "bonnie" then
				S(V3(0.4, 2.0, 0.25), pal.body, V3(0.55 * s, 3.5, 0), ANG(0, 0, rad(-9 * s)))
			end
			if kind ~= "chica" then S(V3(0.5, 0.35, 0.25), pal.acc, V3(0.3 * s, 1.05, 0.72)) end
		end
		if kind == "freddy" then
			local hat = cyl(model, V3(0.9, 1.0, 1.0) * K, BLACK, CF())
			rig[#rig + 1] = { hat, CF(0, 3.45 * K, 0) * ANG(0, 0, rad(90)) }
